import nox.test
import nox.time
import nox.strings
import aether.application
import aether.config
import aether.rate_limit
import aether.testing
from aether.dto import DtoSchema
from aether.errors import UnauthorizedError
from aether.server import ServerError
from aether.application import Application
from aether.config import Config
from aether.context import HttpContext
from aether.module import ModuleBuilder
from aether.rate_limit import RateStore
from aether.response import json_ok
from nox.http import HttpResponse

store: RateStore = RateStore(8)
nox.test.assert_true(store.allow("a", 2, 60000), "first hit")
nox.test.assert_true(store.allow("a", 2, 60000), "second hit")
nox.test.assert_true(not store.allow("a", 2, 60000), "third hit blocked")

short: RateStore = RateStore(8)
nox.test.assert_true(short.allow("a", 1, 20), "short window first")
nox.test.assert_true(not short.allow("a", 1, 20), "short window blocked")
nox.time.sleep_ms(40)
nox.test.assert_true(short.allow("a", 1, 20), "window elapsed on monotonic clock")

# A full store keeps the live key. The next client is refused.
tiny: RateStore = RateStore(1)
nox.test.assert_true(tiny.allow("a", 1, 60000), "bucket a")
nox.test.assert_true(not tiny.allow("a", 1, 60000), "a is full")
nox.test.assert_true(not tiny.allow("b", 1, 60000), "a live bucket is not dropped for b")
nox.test.assert_true(not tiny.allow("a", 1, 60000), "a keeps its own count")

room: RateStore = RateStore(1)
nox.test.assert_true(room.allow("a", 1, 20), "room holds a")
nox.test.assert_true(not room.allow("b", 1, 20), "room refuses b")
nox.time.sleep_ms(40)
nox.test.assert_true(room.allow("b", 1, 20), "expired a frees the slot")

def ping(ctx: HttpContext) -> HttpResponse:
    return json_ok("{\"pong\":true}")

def build(app: Application) -> None:
    m: ModuleBuilder = app.module()
    m.get("/ping", ping)

cfg: Config = aether.config.defaults("test")
cfg.log_requests = False
cfg.metrics = False
cfg.rate_limit_enabled = True
cfg.rate_limit_max = 1
cfg.rate_limit_window_ms = 60000
cfg.trust_x_forwarded_for = False
app: Application = aether.application.boot_with_config(cfg, build)

spoof: dict[str, str] = {}
spoof["X-Forwarded-For"] = "203.0.113.9"
first: HttpResponse = aether.testing.request_peer(app, "GET", "/ping", "", spoof, "198.51.100.10")
nox.test.assert_eq_int(first.status, 200, "peer one allowed")
second: HttpResponse = aether.testing.request_peer(app, "GET", "/ping", "", spoof, "198.51.100.10")
nox.test.assert_eq_int(second.status, 429, "same peer limited")
other: HttpResponse = aether.testing.request_peer(app, "GET", "/ping", "", spoof, "198.51.100.11")
nox.test.assert_eq_int(other.status, 200, "other peer is another bucket")
unknown: HttpResponse = aether.testing.request_peer(app, "GET", "/ping", "", spoof, "")
nox.test.assert_eq_int(unknown.status, 429, "empty peer is limited")
unknown2: HttpResponse = aether.testing.request_peer(app, "GET", "/ping", "", spoof, "")
nox.test.assert_eq_int(unknown2.status, 429, "empty peer stays limited")

cfg2: Config = aether.config.defaults("test")
cfg2.log_requests = False
cfg2.metrics = False
cfg2.rate_limit_enabled = True
cfg2.rate_limit_max = 1
cfg2.rate_limit_window_ms = 60000
cfg2.trust_x_forwarded_for = True
missing: bool = False
try:
    aether.application.boot_with_config(cfg2, build)
except ServerError as err:
    missing = nox.strings.contains(err.message, "AETHER_TRUSTED_PROXIES")
nox.test.assert_true(missing, "trust without a proxy list fails boot")
cfg2.trusted_proxies = "198.51.100.10,198.51.100.11"
trusted: Application = aether.application.boot_with_config(cfg2, build)
hop: dict[str, str] = {}
hop["X-Forwarded-For"] = "203.0.113.9, 10.0.0.1"
t1: HttpResponse = aether.testing.request_peer(trusted, "GET", "/ping", "", hop, "198.51.100.10")
nox.test.assert_eq_int(t1.status, 200, "trusted rightmost hop allowed")
t2: HttpResponse = aether.testing.request_peer(trusted, "GET", "/ping", "", hop, "198.51.100.11")
nox.test.assert_eq_int(t2.status, 429, "same rightmost hop shares a bucket")
outsider: HttpResponse = aether.testing.request_peer(trusted, "GET", "/ping", "", hop, "203.0.113.50")
nox.test.assert_eq_int(outsider.status, 200, "unlisted peer ignores XFF")

cfg3: Config = aether.config.defaults("test")
cfg3.log_requests = False
cfg3.metrics = False
cfg3.rate_limit_enabled = True
cfg3.rate_limit_max = 1
cfg3.rate_limit_window_ms = 60000
cfg3.trust_x_forwarded_for = True
cfg3.trusted_proxies = "198.51.100.10,198.51.100.11"
chain: Application = aether.application.boot_with_config(cfg3, build)
left_a: dict[str, str] = {}
left_a["X-Forwarded-For"] = "203.0.113.9, 203.0.113.50"
left_b: dict[str, str] = {}
left_b["X-Forwarded-For"] = "198.51.100.99, 203.0.113.50"
left_c: dict[str, str] = {}
left_c["X-Forwarded-For"] = "203.0.113.9, 203.0.113.51"
c1: HttpResponse = aether.testing.request_peer(chain, "GET", "/ping", "", left_a, "198.51.100.10")
nox.test.assert_eq_int(c1.status, 200, "real client allowed")
c2: HttpResponse = aether.testing.request_peer(chain, "GET", "/ping", "", left_b, "198.51.100.11")
nox.test.assert_eq_int(c2.status, 429, "spoofed left hop does not open a new bucket")
c3: HttpResponse = aether.testing.request_peer(chain, "GET", "/ping", "", left_c, "198.51.100.10")
nox.test.assert_eq_int(c3.status, 200, "a different rightmost hop is another client")

cfg4: Config = aether.config.defaults("test")
cfg4.log_requests = False
cfg4.metrics = False
cfg4.rate_limit_enabled = True
cfg4.rate_limit_max = 1
cfg4.rate_limit_window_ms = 60000
cfg4.trust_x_forwarded_for = True
cfg4.trusted_proxies = "198.51.100.0/24, 2001:db8::/32"
net: Application = aether.application.boot_with_config(cfg4, build)
cidr_hop: dict[str, str] = {}
cidr_hop["X-Forwarded-For"] = "203.0.113.9, 203.0.113.60"
n1: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", cidr_hop, "198.51.100.10")
nox.test.assert_eq_int(n1.status, 200, "peer inside the CIDR is trusted")
n2: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", cidr_hop, "198.51.100.200")
nox.test.assert_eq_int(n2.status, 429, "another address in the CIDR shares the client")
outside_net: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", cidr_hop, "198.51.101.10")
nox.test.assert_eq_int(outside_net.status, 200, "address outside the CIDR ignores XFF")
v6_hop: dict[str, str] = {}
v6_hop["X-Forwarded-For"] = "198.51.100.9, 203.0.113.70"
n6: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", v6_hop, "2001:db8::5")
nox.test.assert_eq_int(n6.status, 200, "ipv6 CIDR peer is trusted")
n6b: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", v6_hop, "2001:0db8:0000:0000:0000:0000:0000:0005")
nox.test.assert_eq_int(n6b.status, 429, "expanded ipv6 is the same peer")
v6_out: HttpResponse = aether.testing.request_peer(net, "GET", "/ping", "", v6_hop, "2001:db9::5")
nox.test.assert_eq_int(v6_out.status, 200, "ipv6 outside the prefix ignores XFF")

cfg5: Config = aether.config.defaults("test")
cfg5.log_requests = False
cfg5.trust_x_forwarded_for = True
cfg5.trusted_proxies = "198.51.100.0/33"
bad_cidr: bool = False
try:
    aether.application.boot_with_config(cfg5, build)
except ServerError as err2:
    bad_cidr = nox.strings.contains(err2.message, "not an address or CIDR")
nox.test.assert_true(bad_cidr, "a prefix past 32 fails boot")

def deny(ctx: HttpContext) -> bool:
    raise UnauthorizedError("nope")

def build_guarded(app: Application) -> None:
    m: ModuleBuilder = app.module()
    m.use_guard(deny)
    m.get("/ping", ping)

cfg6: Config = aether.config.defaults("test")
cfg6.log_requests = False
cfg6.metrics = False
cfg6.rate_limit_enabled = True
cfg6.rate_limit_max = 1
cfg6.rate_limit_window_ms = 60000
cfg6.trust_x_forwarded_for = False
guarded: Application = aether.application.boot_with_config(cfg6, build_guarded)
g1: HttpResponse = aether.testing.request_peer(guarded, "GET", "/ping", "", {}, "198.51.100.10")
nox.test.assert_eq_int(g1.status, 401, "first request is rejected by the guard and still counted")
g2: HttpResponse = aether.testing.request_peer(guarded, "GET", "/ping", "", {}, "198.51.100.10")
nox.test.assert_eq_int(g2.status, 429, "the next request is limited before the guard")

cfg7: Config = aether.config.defaults("test")
cfg7.log_requests = False
cfg7.metrics = False
cfg7.trust_x_forwarded_for = True
cfg7.trusted_proxies = "198.51.100.10"
cfg7.request_headers = False
bare: bool = False
try:
    aether.application.boot_with_config(cfg7, build)
except ServerError as err3:
    bare = nox.strings.contains(err3.message, "AETHER_REQUEST_HEADERS")
nox.test.assert_true(bare, "trust without request headers fails boot")

def who(ctx: HttpContext) -> HttpResponse:
    return json_ok("{\"ip\":\"" + ctx.client_ip() + "\"}")

def build_who(app: Application) -> None:
    m: ModuleBuilder = app.module()
    m.get("/who", who)

cfg8: Config = aether.config.defaults("test")
cfg8.log_requests = False
cfg8.metrics = False
cfg8.rate_limit_enabled = True
cfg8.rate_limit_max = 1
cfg8.rate_limit_window_ms = 60000
cfg8.trust_x_forwarded_for = True
cfg8.trusted_proxies = "198.51.100.10"
named: Application = aether.application.boot_with_config(cfg8, build_who)
wide: dict[str, str] = {}
wide["X-Forwarded-For"] = "2001:0db8:0000:0000:0000:0000:0000:0001"
w1: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", wide, "198.51.100.10")
nox.test.assert_eq_int(w1.status, 200, "expanded ipv6 allowed")
nox.test.assert_true(nox.strings.contains(w1.body, "2001:db8::1"), "expanded ipv6 is canonical")
tight: dict[str, str] = {}
tight["X-Forwarded-For"] = "2001:db8::1"
w2: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", tight, "198.51.100.10")
nox.test.assert_eq_int(w2.status, 429, "compressed ipv6 is the same bucket")
mapped: dict[str, str] = {}
mapped["X-Forwarded-For"] = "::ffff:203.0.113.90"
w3: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", mapped, "198.51.100.10")
nox.test.assert_eq_int(w3.status, 200, "mapped ipv6 allowed")
nox.test.assert_true(nox.strings.contains(w3.body, "203.0.113.90"), "mapped ipv6 is dotted ipv4")
plain: dict[str, str] = {}
plain["X-Forwarded-For"] = "203.0.113.90"
w4: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", plain, "198.51.100.10")
nox.test.assert_eq_int(w4.status, 429, "dotted form shares the mapped bucket")
junk: dict[str, str] = {}
junk["X-Forwarded-For"] = "not-an-ip"
w5: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", junk, "198.51.100.10")
nox.test.assert_eq_int(w5.status, 200, "invalid hop falls back to the peer")
nox.test.assert_true(nox.strings.contains(w5.body, "198.51.100.10"), "fallback key is the peer")
junk2: dict[str, str] = {}
junk2["X-Forwarded-For"] = "also-bad"
w6: HttpResponse = aether.testing.request_peer(named, "GET", "/who", "", junk2, "198.51.100.10")
nox.test.assert_eq_int(w6.status, 429, "another invalid hop does not open a bucket")

def build_echo(app: Application) -> None:
    m: ModuleBuilder = app.module()
    m.get("/ping", ping)
    schema: DtoSchema = DtoSchema("Echo")
    schema.require("msg", "string")
    m.post_body("/echo", ping, "Echo", schema, schema)

cfg9: Config = aether.config.defaults("test")
cfg9.log_requests = False
cfg9.metrics = False
cfg9.rate_limit_enabled = True
cfg9.rate_limit_max = 1
cfg9.rate_limit_window_ms = 60000
echo: Application = aether.application.boot_with_config(cfg9, build_echo)
v1: HttpResponse = aether.testing.request_peer(echo, "POST", "/echo", "{}", {}, "198.51.100.20")
nox.test.assert_eq_int(v1.status, 422, "validation is rejected")
v2: HttpResponse = aether.testing.request_peer(echo, "POST", "/echo", "{}", {}, "198.51.100.20")
nox.test.assert_eq_int(v2.status, 429, "validation still spends the quota")

cfg10: Config = aether.config.defaults("test")
cfg10.log_requests = False
cfg10.metrics = False
cfg10.rate_limit_enabled = True
cfg10.rate_limit_max = 1
cfg10.rate_limit_window_ms = 60000
cfg10.cors_origins = "*"
miss: Application = aether.application.boot_with_config(cfg10, build)
m1: HttpResponse = aether.testing.request_peer(miss, "GET", "/missing", "", {}, "198.51.100.21")
nox.test.assert_eq_int(m1.status, 404, "unknown path")
m2: HttpResponse = aether.testing.request_peer(miss, "GET", "/ping", "", {}, "198.51.100.21")
nox.test.assert_eq_int(m2.status, 200, "404 does not spend the quota")
m3: HttpResponse = aether.testing.request_peer(miss, "POST", "/ping", "{}", {}, "198.51.100.22")
nox.test.assert_eq_int(m3.status, 405, "wrong method")
m4: HttpResponse = aether.testing.request_peer(miss, "GET", "/ping", "", {}, "198.51.100.22")
nox.test.assert_eq_int(m4.status, 200, "405 does not spend the quota")
opt: dict[str, str] = {}
opt["Origin"] = "https://example.com"
opt["Access-Control-Request-Method"] = "GET"
m5: HttpResponse = aether.testing.request_peer(miss, "OPTIONS", "/ping", "", opt, "198.51.100.23")
nox.test.assert_eq_int(m5.status, 204, "cors preflight")
m6: HttpResponse = aether.testing.request_peer(miss, "GET", "/ping", "", {}, "198.51.100.23")
nox.test.assert_eq_int(m6.status, 200, "options does not spend the quota")

# A known key resets in place. The neighbor stays, so a third key still needs a sweep.
pair: RateStore = RateStore(2)
nox.test.assert_true(pair.allow("a", 2, 60000), "pair a")
nox.test.assert_true(pair.allow("b", 2, 60000), "pair b")
nox.test.assert_true(pair.allow("a", 2, 60000), "pair a second")
nox.test.assert_true(not pair.allow("c", 1, 60000), "pair is full of live keys")
nox.test.assert_true(not pair.allow("a", 2, 60000), "a kept its count without a sweep")

cfg11: Config = aether.config.defaults("test")
cfg11.log_requests = False
cfg11.metrics = False
cfg11.rate_limit_enabled = False
cfg11.rate_limit_window_ms = 0
cfg11.rate_limit_max = 0
off: Application = aether.application.boot_with_config(cfg11, build)
nox.test.assert_true(not off.config.rate_limit_enabled, "limiter off still boots")

cfg12: Config = aether.config.defaults("test")
cfg12.log_requests = False
cfg12.metrics = False
cfg12.rate_limit_enabled = True
cfg12.rate_limit_max = 1
cfg12.rate_limit_window_ms = 0
zero_window: bool = False
try:
    aether.application.boot_with_config(cfg12, build)
except ServerError as err4:
    zero_window = nox.strings.contains(err4.message, "AETHER_RATE_LIMIT_WINDOW_MS")
nox.test.assert_true(zero_window, "a zero window fails boot")

cfg13: Config = aether.config.defaults("test")
cfg13.log_requests = False
cfg13.metrics = False
cfg13.rate_limit_enabled = True
cfg13.rate_limit_max = 0
cfg13.rate_limit_window_ms = 60000
zero_max: bool = False
try:
    aether.application.boot_with_config(cfg13, build)
except ServerError as err5:
    zero_max = nox.strings.contains(err5.message, "AETHER_RATE_LIMIT_MAX must")
nox.test.assert_true(zero_max, "a zero max fails boot")

cfg14: Config = aether.config.defaults("test")
cfg14.log_requests = False
cfg14.metrics = False
cfg14.rate_limit_enabled = True
cfg14.rate_limit_max = 1
cfg14.rate_limit_window_ms = 60000
cfg14.rate_limit_max_buckets = 0
zero_cap: bool = False
try:
    aether.application.boot_with_config(cfg14, build)
except ServerError as err6:
    zero_cap = nox.strings.contains(err6.message, "AETHER_RATE_LIMIT_MAX_BUCKETS")
nox.test.assert_true(zero_cap, "a zero bucket cap fails boot")

cfg15: Config = aether.config.defaults("test")
cfg15.log_requests = False
cfg15.metrics = False
cfg15.rate_limit_enabled = True
cfg15.rate_limit_max = 100
cfg15.rate_limit_window_ms = 60000
cfg15.rate_limit_max_buckets = 1
capped: Application = aether.application.boot_with_config(cfg15, build)
k1: HttpResponse = aether.testing.request_peer(capped, "GET", "/ping", "", {}, "198.51.100.30")
nox.test.assert_eq_int(k1.status, 200, "first client fills the only bucket")
k2: HttpResponse = aether.testing.request_peer(capped, "GET", "/ping", "", {}, "198.51.100.30")
nox.test.assert_eq_int(k2.status, 200, "the same client stays under the request max")
k3: HttpResponse = aether.testing.request_peer(capped, "GET", "/ping", "", {}, "198.51.100.31")
nox.test.assert_eq_int(k3.status, 429, "a second client is refused while the bucket is live")

cfg16: Config = aether.config.defaults("test")
cfg16.log_requests = False
cfg16.metrics = False
cfg16.rate_limit_enabled = True
cfg16.rate_limit_max = 1
cfg16.rate_limit_window_ms = 60000
cfg16.trust_x_forwarded_for = True
cfg16.trusted_proxies = "198.51.100.10"
fuzz: Application = aether.application.boot_with_config(cfg16, build_who)
upper: dict[str, str] = {}
upper["X-Forwarded-For"] = "2001:DB8::1"
f1: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", upper, "198.51.100.10")
nox.test.assert_eq_int(f1.status, 200, "uppercase ipv6 allowed")
nox.test.assert_true(nox.strings.contains(f1.body, "2001:db8::1"), "uppercase ipv6 is lowercase")
lower: dict[str, str] = {}
lower["X-Forwarded-For"] = "2001:db8::1"
f2: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", lower, "198.51.100.10")
nox.test.assert_eq_int(f2.status, 429, "lowercase ipv6 shares the uppercase bucket")
padded: dict[str, str] = {}
padded["X-Forwarded-For"] = "203.0.113.009"
f3: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", padded, "198.51.100.10")
nox.test.assert_eq_int(f3.status, 200, "padded ipv4 allowed")
nox.test.assert_true(nox.strings.contains(f3.body, "203.0.113.9"), "padded ipv4 drops the zero")
plain4: dict[str, str] = {}
plain4["X-Forwarded-For"] = "203.0.113.9"
f4: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", plain4, "198.51.100.10")
nox.test.assert_eq_int(f4.status, 429, "plain ipv4 shares the padded bucket")
mapped_pad: dict[str, str] = {}
mapped_pad["X-Forwarded-For"] = "::ffff:203.0.113.081"
f5: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", mapped_pad, "198.51.100.10")
nox.test.assert_eq_int(f5.status, 200, "mapped padded ipv4 allowed")
nox.test.assert_true(nox.strings.contains(f5.body, "203.0.113.81"), "mapped padded ipv4 is canonical")
zone: dict[str, str] = {}
zone["X-Forwarded-For"] = "2001:db8::1%eth0"
f6: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", zone, "198.51.100.10")
nox.test.assert_eq_int(f6.status, 200, "zone id is not a client key")
nox.test.assert_true(nox.strings.contains(f6.body, "198.51.100.10"), "zone id falls back to the peer")
huge: dict[str, str] = {}
huge["X-Forwarded-For"] = "999.1.1.1"
f7: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", huge, "198.51.100.10")
nox.test.assert_eq_int(f7.status, 429, "a second invalid hop stays on the peer bucket")
mixed: dict[str, str] = {}
mixed["X-Forwarded-For"] = "not-an-ip, 203.0.113.82"
f8: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", mixed, "198.51.100.10")
nox.test.assert_eq_int(f8.status, 200, "garbage then a valid hop is allowed")
nox.test.assert_true(nox.strings.contains(f8.body, "203.0.113.82"), "the valid hop is the key")
real_only: dict[str, str] = {}
real_only["X-Real-IP"] = "203.0.113.083"
f9: HttpResponse = aether.testing.request_peer(fuzz, "GET", "/who", "", real_only, "198.51.100.10")
nox.test.assert_eq_int(f9.status, 200, "x-real-ip allowed")
nox.test.assert_true(nox.strings.contains(f9.body, "203.0.113.83"), "x-real-ip is canonical")

print("rate_window_test ok")
