import nox.test
import aether.container
from aether.container import Container, ContainerError

c: Container = Container()
c.register_name("Svc")
nox.test.assert_true(c.has("Svc"), "has")
nox.test.assert_eq_int(len(c.names()), 1, "names len")

try:
    c.register_name("")
    nox.test.assert_true(False, "should raise")
except ContainerError as e:
    nox.test.assert_true(len(e.message) > 0, "error message")

print("container_test ok")
