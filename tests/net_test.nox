import nox.test
import nox.strings
import aether.config
import aether.application
import aether.server
from aether.config import Config
from aether.application import Application
from aether.context import peer_host
from aether.server import ServerError

def _boot_ok(app: Application) -> None:
    return

nox.test.assert_eq_str(peer_host("198.51.100.10:4000"), "198.51.100.10", "ipv4 port stripped")
nox.test.assert_eq_str(peer_host("198.51.100.10"), "198.51.100.10", "bare host")
nox.test.assert_eq_str(peer_host("[2001:db8::1]:443"), "2001:db8::1", "ipv6 brackets")
nox.test.assert_eq_str(peer_host(""), "", "empty peer")
nox.test.assert_eq_str(peer_host("2001:db8::1"), "2001:db8::1", "bare ipv6 kept")
nox.test.assert_eq_str(peer_host("host:notaport"), "host:notaport", "non-numeric port kept")

cfg: Config = aether.config.defaults("test")
cfg.ipv6 = True
cfg.workers = 4
aether.server.require_ipv6_listen(cfg)
nox.test.assert_eq_int(aether.server.http_ip_family(cfg), 1, "dual stack family")
cfg.ipv6_only = True
nox.test.assert_eq_int(aether.server.http_ip_family(cfg), 2, "ipv6 only family")
plain: Config = aether.config.defaults("test")
nox.test.assert_eq_int(aether.server.http_ip_family(plain), 0, "ipv4 family")

ws: Config = aether.config.defaults("test")
ws.ipv6 = True
ws.workers = 1
ws.ws_enabled = True
rejected: bool = False
try:
    aether.server.require_ipv6_listen(ws)
except ServerError as e:
    rejected = len(e.message) > 0
nox.test.assert_true(rejected, "single-worker websocket stays ipv4")

h3: Config = aether.config.defaults("test")
h3.http3 = True
rejected_tls: bool = False
try:
    aether.server.require_http3(h3)
except ServerError as e2:
    rejected_tls = len(e2.message) > 0
nox.test.assert_true(rejected_tls, "http3 requires tls paths")

h3.tls_cert_path = "cert.pem"
h3.tls_key_path = "key.pem"
h3.ws_enabled = True
rejected_ws: bool = False
try:
    aether.server.require_http3(h3)
except ServerError as e3:
    rejected_ws = len(e3.message) > 0
nox.test.assert_true(rejected_ws, "http3 rejects websocket")

h3.ws_enabled = False
h3.workers = 4
rejected_workers: bool = False
try:
    aether.server.require_http3(h3)
except ServerError as e4:
    rejected_workers = len(e4.message) > 0
nox.test.assert_true(rejected_workers, "http3 rejects multicore")

h3.workers = 1
h3.rate_limit_enabled = True
rejected_rate: bool = False
try:
    aether.server.require_http3(h3)
except ServerError as e5:
    rejected_rate = len(e5.message) > 0
nox.test.assert_true(rejected_rate, "http3 rate limit needs xff")

h3.rate_limit_enabled = False
aether.server.require_http3(h3)
nox.test.assert_true(h3.http3, "http3 single-worker tls accepted")

host: Config = aether.config.defaults("test")
aether.server.require_listen_host(host)
host.host = ""
aether.server.require_listen_host(host)
host.host = "127.0.0.1"
rejected_host: bool = False
try:
    aether.server.require_listen_host(host)
except ServerError as e6:
    rejected_host = nox.strings.contains(e6.message, "AETHER_HOST")
nox.test.assert_true(rejected_host, "host other than 0.0.0.0 is refused")
host.host = "0.0.0.0"
aether.application.boot_with_config(host, _boot_ok)
host.host = "127.0.0.1"
rejected_boot: bool = False
try:
    aether.application.boot_with_config(host, _boot_ok)
except ServerError as e7:
    rejected_boot = nox.strings.contains(e7.message, "AETHER_HOST")
nox.test.assert_true(rejected_boot, "boot refuses a specific host")

print("net_test ok")
