import nox.test
import aether.gateway
from aether.gateway import Gateway, RoomHub

hub: RoomHub = RoomHub()
nox.test.assert_eq_int(hub.member_count("lobby"), 0, "empty room")

gw: Gateway = Gateway()
gw.on("echo", aether.gateway.echo_handler)
gw.set_auth(aether.gateway.require_token_auth("secret"))

nox.test.assert_eq_int(len(gw._events), 1, "echo registered")
print("gateway_test ok")
