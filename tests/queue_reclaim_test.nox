import nox.test
import nox.time
import aether.queue
from nox.sqlite import Connection
from aether.queue import JobRegistry

db: Connection = aether.queue.open_db(":memory:")
aether.queue.ensure_schema(db)

seen: list[str] = []

def handle_job(payload: str) -> None:
    seen.append(payload)

registry: JobRegistry = JobRegistry()
registry.register("demo", handle_job)

id: int = aether.queue.enqueue(db, "demo", "{\"n\":1}", 0)
nox.test.assert_true(id > 0, "enqueue id")

raw: str | None = aether.queue.reserve(db)
nox.test.assert_true(raw != None, "reserved")

nox.time.sleep_ms(50)
n_reclaim: int = aether.queue.reclaim_stale(db, 1)
nox.test.assert_true(n_reclaim >= 1, "reclaimed")

n: int = aether.queue.work(db, registry, 5)
nox.test.assert_eq_int(n, 1, "processed after reclaim")
nox.test.assert_eq_int(len(seen), 1, "handler called")

# Exhaust attempts with zero backoff between tries.
def boom(payload: str) -> None:
    raise aether.queue.QueueError("always fail")

registry.register("boom", boom)
boom_id: int = aether.queue.enqueue(db, "boom", "{\"x\":1}", 0)

k: int = 0
while k < aether.queue.max_attempts():
    aether.queue.set_run_at(db, boom_id, 0)
    aether.queue.work(db, registry, 1)
    k = k + 1

dead: list[str] = aether.queue.list_dead(db, 10)
nox.test.assert_true(len(dead) >= 1, "has dead letter")

aether.queue.requeue_dead(db, boom_id)

# Direct DLQ helper
dead2_id: int = aether.queue.enqueue(db, "boom", "{\"y\":1}", 0)
aether.queue.mark_dead(db, dead2_id, "manual dead")
dead2: list[str] = aether.queue.list_dead(db, 10)
nox.test.assert_true(len(dead2) >= 1, "mark_dead works")

print("queue_reclaim_test ok")
