# aether.module — ModuleBuilder + RouteDef.

from nox.http import HttpResponse
import aether.container
import aether.context
import aether.dto
import aether.guard
import aether.pipe
import aether.interceptor
from aether.container import Container
from aether.context import HttpContext
from aether.dto import DtoSchema
from aether.pipe import validation_pipe
from aether.interceptor import InterceptorFns

class RouteDef:
    method: str
    pattern: str
    handler: (HttpContext) -> HttpResponse
    summary: str
    tag: str
    has_input: bool
    input_schema: DtoSchema
    has_output: bool
    output_schema: DtoSchema
    guards: list[(HttpContext) -> bool]
    pipes: list[(HttpContext) -> None]
    interceptors: list[InterceptorFns]

    def __init__(
        self: RouteDef,
        method: str,
        pattern: str,
        handler: (HttpContext) -> HttpResponse,
        summary: str,
        tag: str,
        has_input: bool,
        input_schema: DtoSchema,
        has_output: bool,
        output_schema: DtoSchema
    ) -> None:
        self.method = method
        self.pattern = pattern
        self.handler = handler
        self.summary = summary
        self.tag = tag
        self.has_input = has_input
        self.input_schema = input_schema
        self.has_output = has_output
        self.output_schema = output_schema
        self.guards = []
        self.pipes = []
        self.interceptors = []

class RouteTable:
    routes: list[RouteDef]

    def __init__(self: RouteTable) -> None:
        self.routes = []

class HookState:
    guards: list[(HttpContext) -> bool]
    pipes: list[(HttpContext) -> None]
    interceptors: list[InterceptorFns]

    def __init__(self: HookState) -> None:
        self.guards = []
        self.pipes = []
        self.interceptors = []

class ModuleBuilder:
    _table: RouteTable
    _hooks: HookState
    _container: Container
    _route_guards: list[(HttpContext) -> bool]
    _route_pipes: list[(HttpContext) -> None]
    _route_interceptors: list[InterceptorFns]
    _default_tag: str

    def __init__(
        self: ModuleBuilder,
        table: RouteTable,
        container: Container,
        hooks: HookState
    ) -> None:
        self._table = table
        self._hooks = hooks
        self._container = container
        self._route_guards = []
        self._route_pipes = []
        self._route_interceptors = []
        self._default_tag = ""

    def tag(self: ModuleBuilder, name: str) -> None:
        self._default_tag = name

    def provide(self: ModuleBuilder, name: str) -> None:
        self._container.register_name(name)

    def use_guard(self: ModuleBuilder, guard: (HttpContext) -> bool) -> None:
        hooks: HookState = self._hooks
        gs: list[(HttpContext) -> bool] = hooks.guards
        gs.append(guard)
        hooks.guards = gs

    def use_pipe(self: ModuleBuilder, pipe: (HttpContext) -> None) -> None:
        hooks: HookState = self._hooks
        ps: list[(HttpContext) -> None] = hooks.pipes
        ps.append(pipe)
        hooks.pipes = ps

    def use_interceptor(self: ModuleBuilder, interceptor: InterceptorFns) -> None:
        hooks: HookState = self._hooks
        xs: list[InterceptorFns] = hooks.interceptors
        xs.append(interceptor)
        hooks.interceptors = xs

    def route_guard(self: ModuleBuilder, guard: (HttpContext) -> bool) -> None:
        gs: list[(HttpContext) -> bool] = self._route_guards
        gs.append(guard)
        self._route_guards = gs

    def route_pipe(self: ModuleBuilder, pipe: (HttpContext) -> None) -> None:
        ps: list[(HttpContext) -> None] = self._route_pipes
        ps.append(pipe)
        self._route_pipes = ps

    def route_interceptor(self: ModuleBuilder, interceptor: InterceptorFns) -> None:
        xs: list[InterceptorFns] = self._route_interceptors
        xs.append(interceptor)
        self._route_interceptors = xs

    def clear_route_meta(self: ModuleBuilder) -> None:
        self._route_guards = []
        self._route_pipes = []
        self._route_interceptors = []

    def _add(
        self: ModuleBuilder,
        method: str,
        pattern: str,
        handler: (HttpContext) -> HttpResponse,
        summary: str,
        has_input: bool,
        input_schema: DtoSchema,
        has_output: bool,
        output_schema: DtoSchema
    ) -> None:
        route: RouteDef = RouteDef(
            method,
            pattern,
            handler,
            summary,
            self._default_tag + "",
            has_input,
            input_schema,
            has_output,
            output_schema
        )
        rg: list[(HttpContext) -> bool] = route.guards
        i: int = 0
        while i < len(self._route_guards):
            rg.append(self._route_guards[i])
            i = i + 1
        route.guards = rg
        rp: list[(HttpContext) -> None] = route.pipes
        i = 0
        while i < len(self._route_pipes):
            rp.append(self._route_pipes[i])
            i = i + 1
        if has_input:
            rp.append(validation_pipe(input_schema))
        route.pipes = rp
        ri: list[InterceptorFns] = route.interceptors
        i = 0
        while i < len(self._route_interceptors):
            ri.append(self._route_interceptors[i])
            i = i + 1
        route.interceptors = ri
        table: RouteTable = self._table
        routes: list[RouteDef] = table.routes
        routes.append(route)
        table.routes = routes
        self.clear_route_meta()

    def get(self: ModuleBuilder, pattern: str, handler: (HttpContext) -> HttpResponse) -> None:
        empty: DtoSchema = DtoSchema("")
        self._add("GET", pattern, handler, "", False, empty, False, empty)

    def post(self: ModuleBuilder, pattern: str, handler: (HttpContext) -> HttpResponse) -> None:
        empty: DtoSchema = DtoSchema("")
        self._add("POST", pattern, handler, "", False, empty, False, empty)

    def put(self: ModuleBuilder, pattern: str, handler: (HttpContext) -> HttpResponse) -> None:
        empty: DtoSchema = DtoSchema("")
        self._add("PUT", pattern, handler, "", False, empty, False, empty)

    def delete(self: ModuleBuilder, pattern: str, handler: (HttpContext) -> HttpResponse) -> None:
        empty: DtoSchema = DtoSchema("")
        self._add("DELETE", pattern, handler, "", False, empty, False, empty)

    def get_documented(
        self: ModuleBuilder,
        pattern: str,
        handler: (HttpContext) -> HttpResponse,
        summary: str,
        output_schema: DtoSchema
    ) -> None:
        empty: DtoSchema = DtoSchema("")
        self._add("GET", pattern, handler, summary, False, empty, True, output_schema)

    def post_body(
        self: ModuleBuilder,
        pattern: str,
        handler: (HttpContext) -> HttpResponse,
        summary: str,
        input_schema: DtoSchema,
        output_schema: DtoSchema
    ) -> None:
        self._add("POST", pattern, handler, summary, True, input_schema, True, output_schema)
