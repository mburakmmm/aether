# aether.guard — request guards as (HttpContext) -> bool functions.
# Cross-module class inheritance is unsupported in Nox; use closures.

import aether.context
from aether.context import HttpContext
import aether.errors
from aether.errors import ForbiddenError, UnauthorizedError

def run_guards(guards: list[(HttpContext) -> bool], ctx: HttpContext) -> None:
    i: int = 0
    while i < len(guards):
        ok: bool = guards[i](ctx)
        if not ok:
            raise ForbiddenError("guard rejected request")
        i = i + 1

def bearer_token(token: str) -> (HttpContext) -> bool:
    def check(ctx: HttpContext) -> bool:
        auth: str = ctx.header("Authorization")
        expected: str = "Bearer " + token
        if auth != expected:
            raise UnauthorizedError("missing or invalid bearer token")
        return True
    return check
