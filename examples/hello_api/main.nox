# hello_api — Aether dogfood example (CRUD + validation)

import nox.http
import nox.json
from nox.http import HttpRequest, HttpResponse
import aether.application
import aether.server
import aether.config
from aether.application import Application
from aether.config import Config
from aether.module import ModuleBuilder
from aether.context import HttpContext
from aether.response import json_ok, json_created, json_no_content, encode_str_map
from aether.errors import NotFoundError
from aether.dto import DtoSchema

class UserService:
    _users: dict[str, str]
    _emails: dict[str, str]
    _next: int

    def __init__(self: UserService) -> None:
        self._users = {}
        self._emails = {}
        self._users["1"] = "ada"
        self._emails["1"] = "ada@example.com"
        self._next = 2

    def find(self: UserService, id: str) -> str | None:
        keys: list[str] = self._users.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == id:
                return self._users[id]
            i = i + 1
        return None

    def email_of(self: UserService, id: str) -> str:
        keys: list[str] = self._emails.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == id:
                return self._emails[id]
            i = i + 1
        return ""

    def create(self: UserService, name: str, email: str) -> str:
        id: str = str(self._next)
        self._next = self._next + 1
        self._users[id] = name
        self._emails[id] = email
        return id

    def update(self: UserService, id: str, name: str, email: str) -> bool:
        if self.find(id) == None:
            return False
        self._users[id] = name
        self._emails[id] = email
        return True

    def delete(self: UserService, id: str) -> bool:
        if self.find(id) == None:
            return False
        # Rebuild maps without id (Nox has no dict delete).
        users: dict[str, str] = {}
        emails: dict[str, str] = {}
        keys: list[str] = self._users.keys()
        i: int = 0
        while i < len(keys):
            k: str = keys[i]
            if k != id:
                users[k] = self._users[k]
                emails[k] = self.email_of(k)
            i = i + 1
        self._users = users
        self._emails = emails
        return True

class UsersModule:
    def configure(self: UsersModule, m: ModuleBuilder) -> None:
        svc: UserService = UserService()
        m.provide("UserService")
        m.tag("users")
        m.prefix("/api")

        create_schema: DtoSchema = DtoSchema("CreateUser")
        create_schema.require("name", "string")
        create_schema.require_format("email", "string", "email")

        update_schema: DtoSchema = DtoSchema("UpdateUser")
        update_schema.require("name", "string")
        update_schema.require_format("email", "string", "email")

        user_schema: DtoSchema = DtoSchema("User")
        user_schema.require("id", "string")
        user_schema.require("name", "string")
        user_schema.require("email", "string")

        m.get_documented("/users/:id", self._show(svc), "Get user by id", user_schema)
        m.post_body("/users", self._create(svc), "Create user", create_schema, user_schema)
        m.put_body("/users/:id", self._update(svc), "Update user", update_schema, user_schema)
        m.delete_documented("/users/:id", self._delete(svc), "Delete user")

    def _user_json(self: UsersModule, id: str, name: str, email: str) -> str:
        data: dict[str, str] = {}
        data["id"] = id
        data["name"] = name
        data["email"] = email
        return encode_str_map(data)

    def _show(self: UsersModule, svc: UserService) -> (HttpContext) -> HttpResponse:
        def show(ctx: HttpContext) -> HttpResponse:
            id: str = ctx.param("id")
            name: str | None = svc.find(id)
            if name == None:
                raise NotFoundError("user not found")
            else:
                found: str = name
                return json_ok(self._user_json(id, found, svc.email_of(id)))
        return show

    def _create(self: UsersModule, svc: UserService) -> (HttpContext) -> HttpResponse:
        def create(ctx: HttpContext) -> HttpResponse:
            raw: str = ctx.input()
            v: JsonValue = nox.json.decode(raw)
            name: str = ""
            email: str = ""
            i: int = 0
            n: int = nox.json.object_len(v)
            while i < n:
                key: str = nox.json.object_key(v, i)
                val: JsonValue = nox.json.object_value(v, i)
                if key == "name" and nox.json.is_string(val):
                    name = nox.json.as_string(val)
                if key == "email" and nox.json.is_string(val):
                    email = nox.json.as_string(val)
                i = i + 1
            id: str = svc.create(name, email)
            return json_created(self._user_json(id, name, email))
        return create

    def _update(self: UsersModule, svc: UserService) -> (HttpContext) -> HttpResponse:
        def update(ctx: HttpContext) -> HttpResponse:
            id: str = ctx.param("id")
            raw: str = ctx.input()
            v: JsonValue = nox.json.decode(raw)
            name: str = ""
            email: str = ""
            i: int = 0
            n: int = nox.json.object_len(v)
            while i < n:
                key: str = nox.json.object_key(v, i)
                val: JsonValue = nox.json.object_value(v, i)
                if key == "name" and nox.json.is_string(val):
                    name = nox.json.as_string(val)
                if key == "email" and nox.json.is_string(val):
                    email = nox.json.as_string(val)
                i = i + 1
            if not svc.update(id, name, email):
                raise NotFoundError("user not found")
            return json_ok(self._user_json(id, name, email))
        return update

    def _delete(self: UsersModule, svc: UserService) -> (HttpContext) -> HttpResponse:
        def delete(ctx: HttpContext) -> HttpResponse:
            id: str = ctx.param("id")
            if not svc.delete(id):
                raise NotFoundError("user not found")
            return json_no_content()
        return delete

def build(app: Application) -> None:
    mod: UsersModule = UsersModule()
    def configure(m: ModuleBuilder) -> None:
        mod.configure(m)
    app.import_module(configure)

cfg: Config = aether.config.load()
app: Application = aether.application.boot_with_config(cfg, build)

def handle(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch(app, req)

aether.server.print_listen(cfg, aether.server.serve_mode(cfg, False))
try:
    workers: int = aether.server.effective_workers(cfg)
    if aether.server.has_tls(cfg):
        aether.server.require_tls_files(cfg)
        if workers > 1:
            nox.http.serve_multicore_tls(cfg.port, handle, workers, cfg.tls_cert_path, cfg.tls_key_path)
        else:
            nox.http.serve_tls(cfg.port, handle, cfg.tls_cert_path, cfg.tls_key_path)
    else:
        if workers > 1:
            nox.http.serve_multicore(cfg.port, handle, workers)
        else:
            nox.http.serve(cfg.port, handle)
finally:
    aether.application.shutdown(app)
