# aether.server - TLS / worker helpers.
#
# Nox `serve*` intrinsikleri DERLEME ZAMANI bare fonksiyon adı ister.
# Bu yüzden Aether, `nox.http.serve(port, handle)` çağrısını SARMALAMAZ.
# Kullanım (scaffold / examples):
#
#   def handle(req: HttpRequest) -> HttpResponse:
#       return aether.application.dispatch_from_parts(
#           req.method, req.target, req.body, req.headers, req.peer_addr, cfg, build)
#   def handle_bare(req: HttpRequest) -> HttpResponse:
#       return aether.application.dispatch_from_parts(
#           req.method, req.target, req.body, aether.application.EMPTY_HEADERS, "", cfg, build)
#   # NOX_POOL_WORKERS must be in the process environment BEFORE exec
#   # (LLVM $main pool, the default backend). apply_pool_workers is too late.
#   if aether.server.materialize_request_headers(cfg):
#       nox.http.serve(cfg.port, handle)
#   else:
#       nox.http.serve(cfg.port, handle_bare)
#
# boot_with_config auto-calls bind(app). Do not close over Application in handle
# (Nox codegen rejects that with serve*).
#
# Dual runtime (Nox 2.0, LLVM is the default backend):
#   LLVM (`noxc run` / `noxc build` / `noxc build --release`): shared M:N pool.
#     `serve_multicore` flattens into that pool (`$nox_pool_serve`). Each slot
#     opens its own SO_REUSEPORT socket; connection fibers are stealable.
#     The pool size is fixed at process start from NOX_POOL_WORKERS (or the
#     CPU count when the program contains serve_multicore and the variable
#     is unset). In-process set_var cannot resize it. If the pool is smaller
#     than AETHER_WORKERS, extra accept loops are dropped.
#   QBE (`noxc run --backend qbe`): one OS thread per serve_multicore worker,
#     each with its own SO_REUSEPORT socket. NOX_POOL_WORKERS is unused.
#   Both: module globals (AppBind, Metrics, RateStore, closures) are per slot.
#     Stolen tasks keep the globals of the slot that started them.
#   See docs/SCOPE.md.
#
# Multicore:
#   workers: int = aether.server.effective_workers(cfg)
#   # export NOX_POOL_WORKERS=$AETHER_WORKERS before launching the process
#   if aether.server.use_os_workers(cfg):
#       nox.http.serve_multicore(app.config.port, handle, workers)
#   else:
#       nox.http.serve(app.config.port, handle)
#
# build() must be idempotent (no process-once migrations/cron). Parent
# boot_with_config does not populate sibling worker AppBinds.

# WebSocket:
#   nox.http.serve_ws(app.config.port, handle, ws_handle)

import nox.fs
import nox.http
import nox.os
from nox.os import OsError
import aether.config
from aether.config import Config

class ServerError(Exception):
    def __init__(self: ServerError, message: str) -> None:
        self.message = message

def has_tls(cfg: Config) -> bool:
    if len(cfg.tls_cert_path) == 0:
        return False
    if len(cfg.tls_key_path) == 0:
        return False
    return True

def require_tls_files(cfg: Config) -> None:
    if not nox.fs.exists(cfg.tls_cert_path):
        raise ServerError("TLS cert missing: " + cfg.tls_cert_path)
    if not nox.fs.exists(cfg.tls_key_path):
        raise ServerError("TLS key missing: " + cfg.tls_key_path)

# Default workers=1; set AETHER_WORKERS>1 for multicore.
def effective_workers(cfg: Config) -> int:
    if cfg.workers > 0:
        return cfg.workers
    return 1

# Wanted pool size as a decimal string (AETHER_WORKERS / cfg.workers).
def pool_workers_wanted(cfg: Config) -> str:
    return str(effective_workers(cfg))

def pool_workers_env() -> str:
    try:
        return nox.os.getenv("NOX_POOL_WORKERS")
    except OsError:
        return ""

# True when the process already has NOX_POOL_WORKERS matching cfg.workers.
# LLVM reads this at process start; in-process set_var cannot resize the pool.
def pool_env_matches(cfg: Config) -> bool:
    return pool_workers_env() == pool_workers_wanted(cfg)

# workers>1 → serve_multicore on LLVM (default) and on QBE (--backend qbe).
def use_os_workers(cfg: Config) -> bool:
    return effective_workers(cfg) > 1

# Best-effort: sets NOX_POOL_WORKERS for *child* processes spawned after this
# call. Does NOT resize an already-created LLVM $main pool — export the
# variable in the launching shell (scripts/aether_env.sh, run.sh).
def apply_pool_workers(cfg: Config) -> None:
    n: int = effective_workers(cfg)
    nox.os.set_var("NOX_POOL_WORKERS", str(n))

# LLVM sizes the M:N pool before user code runs. workers>1 must already
# see NOX_POOL_WORKERS equal to AETHER_WORKERS; a later set_var does not
# add accept loops. QBE ignores the variable, so the same check is safe.
def require_pool_env(cfg: Config) -> None:
    if not use_os_workers(cfg):
        return
    if pool_env_matches(cfg):
        return
    message: str = (
        "AETHER_WORKERS=" + pool_workers_wanted(cfg) +
        " requires NOX_POOL_WORKERS=" + pool_workers_wanted(cfg) +
        " in the environment before the process starts (saw '" +
        pool_workers_env() +
        "'). LLVM reads the pool size at startup; set_var cannot resize it."
    )
    print(message)
    raise ServerError(message)

def warn_pool_env(cfg: Config) -> None:
    require_pool_env(cfg)

# When false, serve handle_bare so Nox 1.29.2 skips iterateHeaders (G1).
# Default true: JWT / CORS / ctx.header() need the map. Bench sets
# AETHER_REQUEST_HEADERS=0.
def materialize_request_headers(cfg: Config) -> bool:
    return cfg.request_headers

# "plain" | "tls" | "ws" | "ws_tls"
def serve_mode(cfg: Config, want_ws: bool) -> str:
    tls: bool = has_tls(cfg)
    if tls:
        if want_ws:
            return "ws_tls"
        return "tls"
    if want_ws:
        return "ws"
    return "plain"

# serve_multicore opens its own IPv4 sockets. IPv6 is listen_v6 + serve_fd
# (Nox 1.142.10) and only when this process has a single worker.
def require_ipv6_listen(cfg: Config) -> None:
    if not cfg.ipv6:
        return
    if use_os_workers(cfg):
        raise ServerError("AETHER_IPV6 requires AETHER_WORKERS=1; serve_multicore listens on IPv4")
    if cfg.ws_enabled:
        raise ServerError("AETHER_IPV6 does not combine with AETHER_WS")

def listen_v6_fd(cfg: Config) -> int:
    require_ipv6_listen(cfg)
    return nox.http.listen_v6(cfg.port, cfg.ipv6_only)

def print_listen(cfg: Config, mode: str) -> None:
    workers: int = effective_workers(cfg)
    warn_pool_env(cfg)
    listen: str = "serve"
    if cfg.ipv6:
        listen = "v6"
    if use_os_workers(cfg):
        listen = "multicore"
    print(
        "aether listening on :" + str(cfg.port) +
        " env=" + cfg.env +
        " mode=" + mode +
        " workers=" + str(workers) +
        " listen=" + listen
    )
