# aether.response - JSON / text HTTP helpers.

from nox.http import HttpResponse
import nox.json

def json(status: int, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/json; charset=utf-8"
    return HttpResponse(status, body, headers)

def json_ok(body: str) -> HttpResponse:
    return json(200, body)

def json_created(body: str) -> HttpResponse:
    return json(201, body)

def json_no_content() -> HttpResponse:
    headers: dict[str, str] = {}
    return HttpResponse(204, "", headers)

def text(status: int, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "text/plain; charset=utf-8"
    return HttpResponse(status, body, headers)

def with_header(resp: HttpResponse, key: str, value: str) -> HttpResponse:
    out: dict[str, str] = {}
    keys: list[str] = resp.headers.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        out[k] = resp.headers[k]
        i = i + 1
    out[key] = value
    return HttpResponse(resp.status, resp.body + "", out)

def encode_str_map(data: dict[str, str]) -> str:
    keys: list[str] = data.keys()
    body: str = "{"
    i: int = 0
    while i < len(keys):
        if i > 0:
            body = body + ","
        k: str = keys[i]
        body = body + nox.json.encode_string(k) + ":" + nox.json.encode_string(data[k])
        i = i + 1
    body = body + "}"
    return body
