# aether.response - JSON / text HTTP helpers.

from nox.http import HttpResponse
import nox.http
import nox.json
import nox.strings
import nox.web
from nox.json import JsonWriter
import aether.errors
from aether.errors import BadRequestError

_JSON_HEADERS: dict[str, str] = {}
_JSON_HEADERS["Content-Type"] = "application/json; charset=utf-8"

def json(status: int, body: str) -> HttpResponse:
    return HttpResponse(status, body, _JSON_HEADERS)

def json_ok(body: str) -> HttpResponse:
    return json(200, body)

# One string field, no intermediate dict. Echo and other single-field
# responses use this instead of encode_str_map.
def json_ok_field(name: str, value: str) -> HttpResponse:
    return json_ok("{" + nox.json.dump_string(name) + ":" + nox.json.dump_string(value) + "}")

def json_created(body: str) -> HttpResponse:
    return json(201, body)

def json_no_content() -> HttpResponse:
    headers: dict[str, str] = {}
    return HttpResponse(204, "", headers)

def text(status: int, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "text/plain; charset=utf-8"
    return HttpResponse(status, body, headers)

def _copy_headers(resp: HttpResponse) -> dict[str, str]:
    out: dict[str, str] = {}
    keys: list[str] = resp.headers.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        out[k] = resp.headers[k]
        i = i + 1
    return out

def with_header(resp: HttpResponse, key: str, value: str) -> HttpResponse:
    out: dict[str, str] = _copy_headers(resp)
    out[key] = value
    return HttpResponse(resp.status, resp.body, out)

def with_headers(resp: HttpResponse, extra: dict[str, str]) -> HttpResponse:
    # Single header-map copy for multiple keys (finalize / CORS hot path).
    out: dict[str, str] = _copy_headers(resp)
    keys: list[str] = extra.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        out[k] = extra[k]
        i = i + 1
    return HttpResponse(resp.status, resp.body, out)

# Copy-on-write then mutate (safe with shared _JSON_HEADERS).
def apply_headers(resp: HttpResponse, extra: dict[str, str]) -> HttpResponse:
    out: dict[str, str] = _copy_headers(resp)
    keys: list[str] = extra.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        out[k] = extra[k]
        i = i + 1
    resp.headers = out
    return resp

def encode_str_map(data: dict[str, str]) -> str:
    keys: list[str] = data.keys()
    n: int = len(keys)
    if n == 0:
        return "{}"
    if n == 1:
        k0: str = keys[0]
        return "{" + nox.json.dump_string(k0) + ":" + nox.json.dump_string(data[k0]) + "}"
    w: JsonWriter = JsonWriter()
    w.begin_object()
    i: int = 0
    while i < n:
        k: str = keys[i]
        w.write_key(k)
        w.write_string(data[k])
        i = i + 1
    w.end_object()
    return w.build()

def json_ok_str(data: dict[str, str]) -> HttpResponse:
    return json_ok(encode_str_map(data))

def has_header(headers: dict[str, str], name: str) -> bool:
    keys: list[str] = headers.keys()
    i: int = 0
    while i < len(keys):
        if keys[i] == name:
            return True
        i = i + 1
    return False

# Headers a response does not already carry. Copy-on-write callers merge this
# map; do not mutate a shared header dict.
def security_extras(headers: dict[str, str]) -> dict[str, str]:
    extra: dict[str, str] = {}
    if not has_header(headers, "X-Content-Type-Options"):
        extra["X-Content-Type-Options"] = "nosniff"
    if not has_header(headers, "X-Frame-Options"):
        extra["X-Frame-Options"] = "DENY"
    if not has_header(headers, "Referrer-Policy"):
        extra["Referrer-Policy"] = "no-referrer"
    return extra

def _set_cookie_value(headers: dict[str, str]) -> str:
    keys: list[str] = headers.keys()
    i: int = 0
    while i < len(keys):
        if keys[i] == "Set-Cookie":
            return headers["Set-Cookie"]
        i = i + 1
    return ""

# Append one Set-Cookie line. nox.http.multi joins with newlines and the
# server writes each line as its own header (Nox 2.0.120).
def _append_set_cookie(resp: HttpResponse, line: str) -> HttpResponse:
    current: str = _set_cookie_value(resp.headers)
    parts: list[str] = []
    if len(current) > 0:
        parts = nox.strings.split(current, "\n")
    parts.append(line)
    return with_header(resp, "Set-Cookie", nox.http.multi(parts))

def with_cookie(
    resp: HttpResponse,
    name: str,
    value: str,
    path: str = "/",
    max_age: int = -1,
    http_only: bool = True,
    secure: bool = False,
    same_site: str = "Lax"
) -> HttpResponse:
    line: str = ""
    try:
        line = nox.web.cookie(name, value, path, max_age, http_only, secure, same_site)
    except ValueError as e:
        raise BadRequestError(e.message)
    return _append_set_cookie(resp, line)

def expire_cookie(resp: HttpResponse, name: str, path: str = "/") -> HttpResponse:
    line: str = ""
    try:
        line = nox.web.expire_cookie(name, path)
    except ValueError as e:
        raise BadRequestError(e.message)
    return _append_set_cookie(resp, line)
