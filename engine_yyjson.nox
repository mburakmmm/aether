# aether.engine_yyjson - opt-in scalar JSON reader.
#
# Import this from the serve entry (and only there) when AETHER_JSON=yyjson.
# The import links nox.yyjson / noxclibs. The core never imports this file.
# Module init arms the worker-local hooks. serve_multicore re-runs init
# in each worker, so every slot arms its own copy.
#
# Covers the scalar body fast path (one required string, or a flat
# string/number/bool object). Nested, format, range, and pattern schemas
# stay on nox.json. Duplicate keys are rejected with the same sentence
# nox.json uses. yyjson itself keeps the first key and has no depth cap;
# this walker closes the duplicate gap. A scalar document deeper than
# nox.json's 32-level cap can still parse here.

import nox.yyjson
from nox.yyjson import YyValue, YyjsonError
import aether.body
import aether.dto
import aether.engines
from aether.body import ValidatedBody
from aether.dto import DtoSchema, Field

def _seen(names: list[str], name: str) -> bool:
    i: int = 0
    while i < len(names):
        if names[i] == name:
            return True
        i = i + 1
    return False

def _field_named(schema: DtoSchema, name: str) -> Field | None:
    i: int = 0
    while i < len(schema.fields):
        if schema.fields[i].name == name:
            return schema.fields[i]
        i = i + 1
    return None

def _kind_ok(v: YyValue, kind: str) -> bool:
    if kind == "string":
        return nox.yyjson.is_string(v)
    if kind == "number":
        return nox.yyjson.is_number(v)
    if kind == "bool":
        return nox.yyjson.is_bool(v)
    return False

def accept_scalar(raw: str, schema: DtoSchema) -> ValidatedBody:
    try:
        v: YyValue = nox.yyjson.parse(raw)
    except YyjsonError as e:
        aether.body.reject(e.message)
        return aether.body.from_raw(raw)
    if not nox.yyjson.is_object(v):
        aether.body.reject("expected a JSON object")
        return aether.body.from_raw(raw)
    str_names: list[str] = []
    str_vals: list[str] = []
    int_names: list[str] = []
    int_vals: list[int] = []
    bool_names: list[str] = []
    bool_vals: list[bool] = []
    seen: list[str] = []
    all_keys: list[str] = []
    n: int = nox.yyjson.object_len(v)
    i: int = 0
    while i < n:
        key: str = nox.yyjson.object_key(v, i)
        if _seen(all_keys, key):
            aether.body.reject("invalid JSON: " + raw)
            return aether.body.from_raw(raw)
        all_keys.append(key)
        found: Field | None = _field_named(schema, key)
        if found != None:
            val: YyValue = nox.yyjson.object_value(v, i)
            if not _kind_ok(val, found.kind):
                aether.body.reject("field '" + key + "' expected type: " + found.kind)
                return aether.body.from_raw(raw)
            seen.append(key)
            if found.kind == "string":
                str_names.append(key)
                str_vals.append(nox.yyjson.as_string(val))
            if found.kind == "number":
                int_names.append(key)
                int_vals.append(int(nox.yyjson.as_number(val)))
            if found.kind == "bool":
                bool_names.append(key)
                bool_vals.append(nox.yyjson.as_bool(val))
        i = i + 1
    j: int = 0
    while j < len(schema.fields):
        field: Field = schema.fields[j]
        if field.required:
            if not _seen(seen, field.name):
                aether.body.reject("missing required field: '" + field.name + "'")
                return aether.body.from_raw(raw)
        j = j + 1
    return aether.body.seal_scalars(raw, str_names, str_vals, int_names, int_vals, bool_names, bool_vals)

def take_required_string(raw: str, name: str) -> str:
    try:
        v: YyValue = nox.yyjson.parse(raw)
    except YyjsonError as e:
        aether.body.reject(e.message)
        return ""
    if not nox.yyjson.is_object(v):
        aether.body.reject("expected a JSON object")
        return ""
    found: str = ""
    hit: bool = False
    all_keys: list[str] = []
    n: int = nox.yyjson.object_len(v)
    i: int = 0
    while i < n:
        key: str = nox.yyjson.object_key(v, i)
        if _seen(all_keys, key):
            aether.body.reject("invalid JSON: " + raw)
            return ""
        all_keys.append(key)
        if key == name:
            val: YyValue = nox.yyjson.object_value(v, i)
            if not nox.yyjson.is_string(val):
                aether.body.reject("field '" + name + "' expected type: string")
                return ""
            found = nox.yyjson.as_string(val)
            hit = True
        i = i + 1
    if not hit:
        aether.body.reject("missing required field: '" + name + "'")
        return ""
    return found

if nox.yyjson.is_supported():
    aether.engines.arm_yyjson(accept_scalar, take_required_string)
else:
    aether.engines.arm_yyjson_unavailable()
