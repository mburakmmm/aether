# aether.context — request-scoped HttpContext + TaskLocal.
#
# DI model (official): closure injection. Container tracks provider *names* only.
# Request-scoped string values live in TaskLocal RequestState (fiber-safe).

from nox.http import HttpRequest
import aether.container
from aether.container import Container
import nox.strings
import nox.url
from nox.url import UrlError

class RequestState:
    active: bool
    request_id: str
    input_json: str
    path: str
    method: str
    values: dict[str, str]

    def __init__(self: RequestState) -> None:
        self.active = False
        self.request_id = ""
        self.input_json = ""
        self.path = ""
        self.method = ""
        self.values = {}

_tl: TaskLocal[RequestState] = TaskLocal[RequestState]()

def _state() -> RequestState:
    got: RequestState | None = _tl.get()
    if got == None:
        created: RequestState = RequestState()
        _tl.set(created)
        return created
    else:
        return got

def begin(rid: str, method: str, path: str) -> None:
    st: RequestState = _state()
    st.active = True
    st.request_id = rid
    st.method = method
    st.path = path
    st.input_json = ""
    st.values = {}

def finish() -> None:
    st: RequestState = _state()
    st.active = False
    st.request_id = ""
    st.input_json = ""
    st.path = ""
    st.method = ""
    st.values = {}
    _tl.clear()

def current_request_id() -> str:
    return _state().request_id

def set_input_json(raw: str) -> None:
    _state().input_json = raw

def input_json() -> str:
    return _state().input_json

def set_request_value(key: str, value: str) -> None:
    st: RequestState = _state()
    vals: dict[str, str] = st.values
    vals[key] = value
    st.values = vals

def get_request_value(key: str) -> str:
    vals: dict[str, str] = _state().values
    keys: list[str] = vals.keys()
    i: int = 0
    while i < len(keys):
        if keys[i] == key:
            return vals[key]
        i = i + 1
    return ""

def _substr(s: str, start: int, end_idx: int) -> str:
    out: str = ""
    i: int = start
    while i < end_idx:
        out = out + s[i]
        i = i + 1
    return out

def path_only(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return target
    return _substr(target, 0, q)

def query_string(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return ""
    return _substr(target, q + 1, len(target))

def normalize_path(path: str) -> str:
    if len(path) == 0:
        return "/"
    if path == "/":
        return "/"
    last: int = len(path) - 1
    if path[last] == "/":
        return _substr(path, 0, last)
    return path

def parse_query(target: str) -> dict[str, str]:
    raw: str = query_string(target)
    if len(raw) == 0:
        empty: dict[str, str] = {}
        return empty
    try:
        return nox.url.query_decode(nox.strings.replace(raw, "+", "%20"))
    except UrlError:
        empty2: dict[str, str] = {}
        return empty2

def header_get(headers: dict[str, str], name: str) -> str:
    want: str = nox.strings.lower(name)
    keys: list[str] = headers.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        if nox.strings.lower(k) == want:
            return headers[k]
        i = i + 1
    return ""

def client_ip(headers: dict[str, str], trust_xff: bool) -> str:
    if trust_xff:
        xff: str = header_get(headers, "X-Forwarded-For")
        if len(xff) > 0:
            parts: list[str] = nox.strings.split(xff, ",")
            if len(parts) > 0:
                hop: str = parts[0]
                out: str = ""
                i: int = 0
                while i < len(hop):
                    ch: str = hop[i]
                    if ch != " ":
                        out = out + ch
                    i = i + 1
                if len(out) > 0:
                    return out
        real: str = header_get(headers, "X-Real-IP")
        if len(real) > 0:
            return real
    return ""

class HttpContext:
    request: HttpRequest
    params: dict[str, str]
    query: dict[str, str]
    container: Container
    request_id: str
    input_body: str
    path: str
    method: str
    trust_xff: bool

    def __init__(
        self: HttpContext,
        request: HttpRequest,
        params: dict[str, str],
        container: Container,
        request_id_value: str,
        input_body: str,
        trust_xff: bool
    ) -> None:
        self.request = request
        self.params = params
        self.query = parse_query(request.target)
        self.container = container
        self.request_id = request_id_value
        self.input_body = input_body
        self.path = normalize_path(path_only(request.target))
        self.method = request.method
        self.trust_xff = trust_xff

    def param(self: HttpContext, name: str) -> str:
        keys: list[str] = self.params.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return self.params[name]
            i = i + 1
        return ""

    def query_param(self: HttpContext, name: str) -> str:
        keys: list[str] = self.query.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return self.query[name]
            i = i + 1
        return ""

    def header(self: HttpContext, name: str) -> str:
        return header_get(self.request.headers, name)

    def body(self: HttpContext) -> str:
        return self.request.body

    def client_ip(self: HttpContext) -> str:
        return client_ip(self.request.headers, self.trust_xff)

    def has_provider(self: HttpContext, name: str) -> bool:
        return self.container.has(name)

    def set_input(self: HttpContext, raw: str) -> None:
        self.input_body = raw
        set_input_json(raw)

    def input(self: HttpContext) -> str:
        if len(self.input_body) > 0:
            return self.input_body
        return input_json()

    def set_request_value(self: HttpContext, key: str, value: str) -> None:
        set_request_value(key, value)

    def get_request_value(self: HttpContext, key: str) -> str:
        return get_request_value(key)
