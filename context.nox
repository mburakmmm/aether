# aether.context - request-scoped HttpContext + TaskLocal.
#
# DI model (official): closure injection. Container tracks provider *names* only.
# Request-scoped string values live in TaskLocal RequestState (fiber-safe).

from nox.http import HttpRequest, HttpResponse, ResponseStream
import aether.container
import aether.body
import aether.response
from aether.container import Container
from aether.body import ValidatedBody
import nox.strings
import nox.url
import nox.web
from nox.url import UrlError

# Shared empty map for begin() — set_request_value copy-on-writes (A4).
EMPTY_VALUES: dict[str, str] = {}

# Shared sentinel before first validated_body() (A3). Ping/static handlers never
# allocate a per-request ValidatedBody; _has_body stays false.
_EMPTY_BODY: ValidatedBody = aether.body.from_raw("")

class RequestState:
    active: bool
    request_id: str
    input_json: str
    path: str
    method: str
    values: dict[str, str]

    def __init__(self: RequestState) -> None:
        self.active = False
        self.request_id = ""
        self.input_json = ""
        self.path = ""
        self.method = ""
        self.values = EMPTY_VALUES

_tl: TaskLocal[RequestState] = TaskLocal[RequestState]()

# Nox TaskLocal.set is a no-op outside a fiber (top-level tests, aether.testing).
# After the first failed publish, this slot keeps one RequestState. A serve
# fiber publishes successfully and never uses the fallback.
class SyncRequest:
    ready: bool
    state: RequestState

    def __init__(self: SyncRequest) -> None:
        self.ready = False
        self.state = RequestState()

_sync: SyncRequest = SyncRequest()

def _state() -> RequestState:
    got: RequestState | None = _tl.get()
    if got != None:
        return got
    if _sync.ready:
        return _sync.state
    created: RequestState = RequestState()
    _tl.set(created)
    stored: RequestState | None = _tl.get()
    if stored != None:
        return stored
    _sync.state = created
    _sync.ready = True
    return created

def begin(rid: str, method: str, path: str) -> None:
    st: RequestState = _state()
    st.active = True
    st.request_id = rid
    st.method = method
    st.path = path
    st.input_json = ""
    st.values = EMPTY_VALUES

def finish() -> None:
    st: RequestState = _state()
    st.active = False
    st.request_id = ""
    st.input_json = ""
    st.path = ""
    st.method = ""
    st.values = EMPTY_VALUES
    _tl.clear()

def current_request_id() -> str:
    return _state().request_id

def set_input_json(raw: str) -> None:
    _state().input_json = raw

def input_json() -> str:
    return _state().input_json

def set_request_value(key: str, value: str) -> None:
    # Copy-on-write so EMPTY_VALUES is never mutated across fibers (A4).
    st: RequestState = _state()
    vals: dict[str, str] = {}
    old: dict[str, str] = st.values
    keys: list[str] = old.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        vals[k] = old[k]
        i = i + 1
    vals[key] = value
    st.values = vals

def get_request_value(key: str) -> str:
    vals: dict[str, str] = _state().values
    keys: list[str] = vals.keys()
    i: int = 0
    while i < len(keys):
        if keys[i] == key:
            return vals[key]
        i = i + 1
    return ""

def _substr(s: str, start: int, end_idx: int) -> str:
    out: str = ""
    i: int = start
    while i < end_idx:
        out = out + s[i]
        i = i + 1
    return out

def path_only(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return target
    return _substr(target, 0, q)

def query_string(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return ""
    return _substr(target, q + 1, len(target))

def normalize_path(path: str) -> str:
    if len(path) == 0:
        return "/"
    if path == "/":
        return "/"
    last: int = len(path) - 1
    if path[last] == "/":
        return _substr(path, 0, last)
    return path

def parse_query(target: str) -> dict[str, str]:
    raw: str = query_string(target)
    if len(raw) == 0:
        empty: dict[str, str] = {}
        return empty
    try:
        return nox.url.query_decode(nox.strings.replace(raw, "+", "%20"))
    except UrlError:
        empty2: dict[str, str] = {}
        return empty2

def header_get(headers: dict[str, str], name: str) -> str:
    want: str = nox.strings.lower(name)
    keys: list[str] = headers.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        if nox.strings.lower(k) == want:
            return headers[k]
        i = i + 1
    return ""

def _all_digits(s: str, start: int) -> bool:
    if start >= len(s):
        return False
    i: int = start
    while i < len(s):
        b: int = nox.strings.byte_at(s, i)
        if b < 48 or b > 57:
            return False
        i = i + 1
    return True

# Socket peer from Nox: IPv4 "a.b.c.d:port", IPv6 "[addr]:port".
# A bare host (no port) is returned unchanged.
def peer_host(peer: str) -> str:
    if len(peer) == 0:
        return ""
    if nox.strings.byte_at(peer, 0) == 91:
        end: int = nox.strings.index_of(peer, "]")
        if end > 1:
            return _substr(peer, 1, end)
        return peer
    colons: int = 0
    last: int = -1
    i: int = 0
    while i < len(peer):
        if peer[i] == ":":
            colons = colons + 1
            last = i
        i = i + 1
    if colons == 1 and last > 0 and _all_digits(peer, last + 1):
        return _substr(peer, 0, last)
    return peer

def _strip_spaces(raw: str) -> str:
    out: str = ""
    i: int = 0
    while i < len(raw):
        ch: str = raw[i]
        if ch != " ":
            out = out + ch
        i = i + 1
    return out

def _parse_ipv4(host: str) -> list[int]:
    bad: list[int] = []
    if len(host) == 0:
        return bad
    parts: list[str] = nox.strings.split(host, ".")
    if len(parts) != 4:
        return bad
    out: list[int] = []
    i: int = 0
    while i < 4:
        part: str = parts[i]
        if len(part) == 0 or len(part) > 3:
            return bad
        if not _all_digits(part, 0):
            return bad
        n: int = int(part)
        if n > 255:
            return bad
        out.append(n)
        i = i + 1
    return out

def _hex_value(byte: int) -> int:
    if byte >= 48 and byte <= 57:
        return byte - 48
    if byte >= 97 and byte <= 102:
        return byte - 87
    if byte >= 65 and byte <= 70:
        return byte - 55
    return -1

def _parse_v6_group(part: str) -> int:
    if len(part) == 0 or len(part) > 4:
        return -1
    n: int = 0
    i: int = 0
    while i < len(part):
        digit: int = _hex_value(nox.strings.byte_at(part, i))
        if digit < 0:
            return -1
        n = (n << 4) | digit
        i = i + 1
    return n

def _v6_side_bad(groups: list[int]) -> bool:
    if len(groups) == 1 and groups[0] < 0:
        return True
    return False

def _parse_v6_side(side: str) -> list[int]:
    bad: list[int] = []
    bad.append(-1)
    if len(side) == 0:
        empty: list[int] = []
        return empty
    parts: list[str] = nox.strings.split(side, ":")
    out: list[int] = []
    i: int = 0
    while i < len(parts):
        part: str = parts[i]
        if len(part) == 0:
            return bad
        if nox.strings.index_of(part, ".") >= 0:
            if i != len(parts) - 1:
                return bad
            v4: list[int] = _parse_ipv4(part)
            if len(v4) != 4:
                return bad
            out.append((v4[0] << 8) | v4[1])
            out.append((v4[2] << 8) | v4[3])
        else:
            group: int = _parse_v6_group(part)
            if group < 0:
                return bad
            out.append(group)
        i = i + 1
    return out

def _parse_ipv6(host: str) -> list[int]:
    none: list[int] = []
    if len(host) == 0:
        return none
    if nox.strings.index_of(host, "%") >= 0:
        return none
    dbl: int = nox.strings.index_of(host, "::")
    if dbl >= 0:
        after: str = _substr(host, dbl + 2, len(host))
        if nox.strings.index_of(after, "::") >= 0:
            return none
        left: list[int] = _parse_v6_side(_substr(host, 0, dbl))
        right: list[int] = _parse_v6_side(after)
        if _v6_side_bad(left) or _v6_side_bad(right):
            return none
        zeros: int = 8 - len(left) - len(right)
        if zeros < 1:
            return none
        merged: list[int] = []
        i: int = 0
        while i < len(left):
            merged.append(left[i])
            i = i + 1
        z: int = 0
        while z < zeros:
            merged.append(0)
            z = z + 1
        j: int = 0
        while j < len(right):
            merged.append(right[j])
            j = j + 1
        if len(merged) != 8:
            return none
        return merged
    whole: list[int] = _parse_v6_side(host)
    if _v6_side_bad(whole) or len(whole) != 8:
        return none
    return whole

def _pack_v4(octets: list[int]) -> int:
    return (octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3]

def _mask_bits(width: int, prefix: int) -> int:
    if prefix <= 0:
        return 0
    mask: int = 0
    bit: int = 0
    while bit < prefix:
        mask = (mask << 1) | 1
        bit = bit + 1
    return mask << (width - prefix)

def _ipv4_in_prefix(peer: list[int], net: list[int], prefix: int) -> bool:
    if prefix == 0:
        return True
    mask: int = _mask_bits(32, prefix)
    return (_pack_v4(peer) & mask) == (_pack_v4(net) & mask)

def _groups_in_prefix(peer: list[int], net: list[int], prefix: int) -> bool:
    if prefix == 0:
        return True
    full: int = 0
    left: int = prefix
    while left >= 16:
        full = full + 1
        left = left - 16
    i: int = 0
    while i < full:
        if peer[i] != net[i]:
            return False
        i = i + 1
    if left == 0:
        return True
    mask: int = _mask_bits(16, left)
    return (peer[full] & mask) == (net[full] & mask)

def _same_address(left: str, right: str) -> bool:
    l4: list[int] = _parse_ipv4(left)
    r4: list[int] = _parse_ipv4(right)
    if len(l4) == 4 and len(r4) == 4:
        return _pack_v4(l4) == _pack_v4(r4)
    l6: list[int] = _parse_ipv6(left)
    r6: list[int] = _parse_ipv6(right)
    if len(l6) == 8 and len(r6) == 8:
        i: int = 0
        while i < 8:
            if l6[i] != r6[i]:
                return False
            i = i + 1
        return True
    return left == right

def _prefix_of(entry: str) -> int:
    slash: int = nox.strings.index_of(entry, "/")
    if slash < 1:
        return -1
    pref: str = _substr(entry, slash + 1, len(entry))
    if not _all_digits(pref, 0):
        return -1
    return int(pref)

def _cidr_has(peer: str, entry: str) -> bool:
    slash: int = nox.strings.index_of(entry, "/")
    if slash < 1:
        return False
    prefix: int = _prefix_of(entry)
    if prefix < 0:
        return False
    addr: str = _substr(entry, 0, slash)
    p4: list[int] = _parse_ipv4(peer)
    n4: list[int] = _parse_ipv4(addr)
    if len(p4) == 4 and len(n4) == 4:
        if prefix > 32:
            return False
        return _ipv4_in_prefix(p4, n4, prefix)
    p6: list[int] = _parse_ipv6(peer)
    n6: list[int] = _parse_ipv6(addr)
    if len(p6) == 8 and len(n6) == 8:
        if prefix > 128:
            return False
        return _groups_in_prefix(p6, n6, prefix)
    return False

def _entry_valid(entry: str) -> bool:
    slash: int = nox.strings.index_of(entry, "/")
    if slash < 0:
        v4: list[int] = _parse_ipv4(entry)
        if len(v4) == 4:
            return True
        v6: list[int] = _parse_ipv6(entry)
        return len(v6) == 8
    prefix: int = _prefix_of(entry)
    if prefix < 0:
        return False
    addr: str = _substr(entry, 0, slash)
    a4: list[int] = _parse_ipv4(addr)
    if len(a4) == 4:
        return prefix <= 32
    a6: list[int] = _parse_ipv6(addr)
    if len(a6) == 8:
        return prefix <= 128
    return False

# Empty string means every entry is an address or a CIDR.
def proxy_list_error(proxies: str) -> str:
    parts: list[str] = nox.strings.split(proxies, ",")
    i: int = 0
    while i < len(parts):
        entry: str = _strip_spaces(parts[i])
        if len(entry) > 0 and not _entry_valid(entry):
            return entry
        i = i + 1
    return ""

def peer_trusted(peer: str, proxies: str) -> bool:
    if len(peer) == 0 or len(proxies) == 0:
        return False
    parts: list[str] = nox.strings.split(proxies, ",")
    i: int = 0
    while i < len(parts):
        entry: str = _strip_spaces(parts[i])
        if len(entry) > 0:
            if nox.strings.index_of(entry, "/") >= 0:
                if _cidr_has(peer, entry):
                    return True
            else:
                if _same_address(peer, entry):
                    return True
        i = i + 1
    return False

def _hex_group(n: int) -> str:
    if n == 0:
        return "0"
    digits: str = "0123456789abcdef"
    out: str = ""
    shift: int = 12
    started: bool = False
    while shift >= 0:
        d: int = (n >> shift) & 15
        if d != 0 or started:
            out = out + digits[d]
            started = True
        shift = shift - 4
    return out

def _ends_colon(s: str) -> bool:
    if len(s) == 0:
        return False
    return s[len(s) - 1] == ":"

# RFC 5952 text. An IPv4-mapped address is the dotted IPv4 form, so
# ::ffff:203.0.113.9 and 203.0.113.9 share one rate-limit key.
def _canonical_ipv6(groups: list[int]) -> str:
    if groups[0] == 0 and groups[1] == 0 and groups[2] == 0 and groups[3] == 0 and groups[4] == 0 and groups[5] == 65535:
        return str((groups[6] >> 8) & 255) + "." + str(groups[6] & 255) + "." + str((groups[7] >> 8) & 255) + "." + str(groups[7] & 255)
    best_at: int = -1
    best_len: int = 0
    i: int = 0
    while i < 8:
        if groups[i] == 0:
            j: int = i
            while j < 8 and groups[j] == 0:
                j = j + 1
            n: int = j - i
            if n > best_len:
                best_len = n
                best_at = i
            i = j
        else:
            i = i + 1
    if best_len < 2:
        best_at = -1
    out: str = ""
    i = 0
    while i < 8:
        if i == best_at:
            out = out + "::"
            i = i + best_len
        else:
            if len(out) > 0 and not _ends_colon(out):
                out = out + ":"
            out = out + _hex_group(groups[i])
            i = i + 1
    return out

# Empty when the text is not an IP. IPv4 drops leading zeros. IPv6 is lowercase
# and compressed. The rate limiter uses this text as the bucket key.
def canonical_ip(host: str) -> str:
    v4: list[int] = _parse_ipv4(host)
    if len(v4) == 4:
        return str(v4[0]) + "." + str(v4[1]) + "." + str(v4[2]) + "." + str(v4[3])
    v6: list[int] = _parse_ipv6(host)
    if len(v6) == 8:
        return _canonical_ipv6(v6)
    return ""

# Rightmost valid IP that is not itself a trusted proxy. A client can prepend
# a fake address; the proxy appends the hop it actually saw. A hop that is not
# an IP is skipped, so it cannot mint a bucket. When every hop is trusted, the
# leftmost valid address is the client.
def _forwarded_client(xff: str, proxies: str) -> str:
    parts: list[str] = nox.strings.split(xff, ",")
    n: int = len(parts)
    i: int = n - 1
    while i >= 0:
        hop: str = _strip_spaces(parts[i])
        if len(hop) > 0 and not peer_trusted(hop, proxies):
            canon: str = canonical_ip(hop)
            if len(canon) > 0:
                return canon
        i = i - 1
    j: int = 0
    while j < n:
        first: str = _strip_spaces(parts[j])
        if len(first) > 0:
            canon2: str = canonical_ip(first)
            if len(canon2) > 0:
                return canon2
        j = j + 1
    return ""

def client_ip(headers: dict[str, str], trust_xff: bool, proxies: str) -> str:
    if trust_xff:
        xff: str = header_get(headers, "X-Forwarded-For")
        if len(xff) > 0:
            picked: str = _forwarded_client(xff, proxies)
            if len(picked) > 0:
                return picked
        real: str = header_get(headers, "X-Real-IP")
        if len(real) > 0:
            real_ip: str = canonical_ip(_strip_spaces(real))
            if len(real_ip) > 0:
                return real_ip
    return ""

class HttpContext:
    request: HttpRequest
    params: dict[str, str]
    query: dict[str, str]
    _query_parsed: bool
    container: Container
    request_id: str
    input_body: str
    path: str
    method: str
    trust_xff: bool
    _has_body: bool
    _body: ValidatedBody
    _scalar_hit: bool
    _scalar_name: str
    _scalar_val: str
    security_headers: bool
    cors_origins: str
    json_engine: str
    trusted_proxies: str
    _stream_status: int

    def __init__(
        self: HttpContext,
        request: HttpRequest,
        params: dict[str, str],
        container: Container,
        request_id_value: str,
        input_body: str,
        trust_xff: bool,
        path: str,
        security_headers: bool = False,
        cors_origins: str = "",
        json_engine: str = "std",
        trusted_proxies: str = ""
    ) -> None:
        empty_q: dict[str, str] = {}
        self.request = request
        self.params = params
        self.query = empty_q
        self._query_parsed = False
        self.container = container
        self.request_id = request_id_value
        self.input_body = input_body
        # path already normalized by dispatch (A2).
        self.path = path
        self.method = request.method
        self.trust_xff = trust_xff
        self._has_body = False
        self._body = _EMPTY_BODY
        self._scalar_hit = False
        self._scalar_name = ""
        self._scalar_val = ""
        self.security_headers = security_headers
        self.cors_origins = cors_origins
        self.json_engine = json_engine
        self.trusted_proxies = trusted_proxies
        self._stream_status = 200

    def ensure_query(self: HttpContext) -> None:
        if self._query_parsed:
            return
        self.query = parse_query(self.request.target)
        self._query_parsed = True

    def param(self: HttpContext, name: str) -> str:
        keys: list[str] = self.params.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return self.params[name]
            i = i + 1
        return ""

    def query_param(self: HttpContext, name: str) -> str:
        self.ensure_query()
        keys: list[str] = self.query.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return self.query[name]
            i = i + 1
        return ""

    def header(self: HttpContext, name: str) -> str:
        return nox.web.header(self.request, name)

    def body(self: HttpContext) -> str:
        return self.request.body

    def client_ip(self: HttpContext) -> str:
        # Trusted XFF wins only when the TCP peer is a listed proxy.
        # The client is the canonical rightmost hop that is not itself listed.
        # Empty when the serve handle did not pass a parseable req.peer_addr
        # and no forwarded address was usable.
        raw: str = peer_host(self.request.peer_addr)
        peer: str = canonical_ip(raw)
        if self.trust_xff and peer_trusted(raw, self.trusted_proxies):
            forwarded: str = client_ip(self.request.headers, True, self.trusted_proxies)
            if len(forwarded) > 0:
                return forwarded
        return peer

    def has_provider(self: HttpContext, name: str) -> bool:
        return self.container.has(name)

    def set_input(self: HttpContext, raw: str) -> None:
        self.input_body = raw
        set_input_json(raw)
        self._has_body = False
        self._body = _EMPTY_BODY

    def set_validated_body(self: HttpContext, body: ValidatedBody) -> None:
        raw: str = body.raw()
        self.input_body = raw
        set_input_json(raw)
        self._body = body
        self._has_body = True

    def input(self: HttpContext) -> str:
        if len(self.input_body) > 0:
            return self.input_body
        return input_json()

    def set_request_value(self: HttpContext, key: str, value: str) -> None:
        set_request_value(key, value)

    def get_request_value(self: HttpContext, key: str) -> str:
        return get_request_value(key)

    def validated_body(self: HttpContext) -> ValidatedBody:
        if self._has_body:
            return self._body
        body: ValidatedBody = aether.body.from_raw(self.input())
        self._body = body
        self._has_body = True
        return body

    def set_scalar_string(self: HttpContext, raw: str, name: str, value: str) -> None:
        self.input_body = raw
        set_input_json(raw)
        self._scalar_hit = True
        self._scalar_name = name
        self._scalar_val = value
        self._has_body = False

    def input_str(self: HttpContext, name: str) -> str:
        if self._scalar_hit:
            if self._scalar_name == name:
                return self._scalar_val
        return self.validated_body().get_str(name)

    def input_int(self: HttpContext, name: str) -> int:
        return self.validated_body().get_int(name)

    def input_bool(self: HttpContext, name: str) -> bool:
        return self.validated_body().get_bool(name)

    def query_json(self: HttpContext) -> str:
        return get_request_value("aether.query_json")

    def header_json(self: HttpContext) -> str:
        return get_request_value("aether.header_json")

    def jwt_claims(self: HttpContext) -> str:
        return get_request_value("aether.jwt")

    def cookie(self: HttpContext, name: str) -> str:
        raw: str = self.header("Cookie")
        parsed: dict[str, str] = nox.web.parse_cookies(raw)
        keys: list[str] = parsed.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return parsed[name]
            i = i + 1
        return ""

    def _stream_headers(self: HttpContext, headers: dict[str, str]) -> dict[str, str]:
        merged: dict[str, str] = {}
        keys: list[str] = headers.keys()
        i: int = 0
        while i < len(keys):
            k: str = keys[i]
            merged[k] = headers[k]
            i = i + 1
        if self.security_headers:
            sec: dict[str, str] = aether.response.security_extras(merged)
            sk: list[str] = sec.keys()
            si: int = 0
            while si < len(sk):
                merged[sk[si]] = sec[sk[si]]
                si = si + 1
        if len(self.request_id) > 0:
            if not aether.response.has_header(merged, "X-Request-Id"):
                merged["X-Request-Id"] = self.request_id
        allow: str = _stream_allow_origin(self.cors_origins, nox.web.header(self.request, "Origin"))
        if len(allow) > 0:
            if not aether.response.has_header(merged, "Access-Control-Allow-Origin"):
                merged["Access-Control-Allow-Origin"] = allow
            if not aether.response.has_header(merged, "Vary"):
                merged["Vary"] = "Origin"
        return merged

    # Start a chunked response on the live connection (req.conn). Headers are
    # written immediately. Return finish_stream(stream) from the handler.
    # conn 0 (in-process tests) records chunks on the stream; the runtime
    # ignores the placeholder HttpResponse once a real stream has started.
    def stream(self: HttpContext, status: int, headers: dict[str, str]) -> ResponseStream:
        self._stream_status = status
        merged: dict[str, str] = self._stream_headers(headers)
        req: HttpRequest = self.request
        opened: ResponseStream = req.stream(status, merged)
        return opened

    def sse(self: HttpContext) -> ResponseStream:
        headers: dict[str, str] = {}
        headers["Content-Type"] = "text/event-stream; charset=utf-8"
        headers["Cache-Control"] = "no-cache"
        headers["X-Accel-Buffering"] = "no"
        opened: ResponseStream = self.stream(200, headers)
        return opened

    def finish_stream(self: HttpContext, stream: ResponseStream) -> HttpResponse:
        stream.end()
        body: str = ""
        req: HttpRequest = self.request
        if req.conn == 0:
            chunks: list[str] = stream.sent
            body = _join_chunks(chunks)
        headers: dict[str, str] = {}
        headers["X-Aether-Stream"] = "1"
        return HttpResponse(self._stream_status, body, headers)

def _stream_allow_origin(origins_cfg: str, origin: str) -> str:
    cfg: str = nox.strings.trim(origins_cfg)
    if len(cfg) == 0:
        return ""
    if cfg == "*":
        return "*"
    if len(origin) == 0:
        return ""
    parts: list[str] = nox.strings.split(cfg, ",")
    i: int = 0
    while i < len(parts):
        item: str = nox.strings.trim(parts[i])
        if item == origin:
            return origin
        i = i + 1
    return ""

def _join_chunks(chunks: list[str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(chunks):
        out = out + chunks[i]
        i = i + 1
    return out
