# aether.dto — schema builder + nested + format validation.

import nox.json
import nox.validate
import nox.strings
import nox.uuid
from nox.json import JsonError
from nox.validate import Schema
import aether.errors
from aether.errors import ValidationError

class Field:
    name: str
    kind: str
    required: bool
    format_name: str
    description: str
    item_kind: str
    minimum: int
    maximum: int
    has_min: bool
    has_max: bool

    def __init__(
        self: Field,
        name: str,
        kind: str,
        required: bool,
        format_name: str,
        description: str,
        item_kind: str
    ) -> None:
        self.name = name
        self.kind = kind
        self.required = required
        self.format_name = format_name
        self.description = description
        self.item_kind = item_kind
        self.minimum = 0
        self.maximum = 0
        self.has_min = False
        self.has_max = False

class DtoSchema:
    name: str
    fields: list[Field]
    nested_names: list[str]
    nested_schemas: list[DtoSchema]
    _flat: Schema

    def __init__(self: DtoSchema, name: str) -> None:
        self.name = name
        self.fields = []
        self.nested_names = []
        self.nested_schemas = []
        self._flat = Schema()

    def require(self: DtoSchema, name: str, kind: str) -> None:
        fields: list[Field] = self.fields
        fields.append(Field(name, kind, True, "", "", ""))
        self.fields = fields
        self._flat.require(name, kind)

    def optional(self: DtoSchema, name: str, kind: str) -> None:
        fields: list[Field] = self.fields
        fields.append(Field(name, kind, False, "", "", ""))
        self.fields = fields
        self._flat.optional(name, kind)

    def require_format(self: DtoSchema, name: str, kind: str, format_name: str) -> None:
        fields: list[Field] = self.fields
        fields.append(Field(name, kind, True, format_name, "", ""))
        self.fields = fields
        self._flat.require(name, kind)

    def require_number_range(self: DtoSchema, name: str, minimum: int, maximum: int) -> None:
        fields: list[Field] = self.fields
        f: Field = Field(name, "number", True, "", "", "")
        f.has_min = True
        f.has_max = True
        f.minimum = minimum
        f.maximum = maximum
        fields.append(f)
        self.fields = fields
        self._flat.require(name, "number")

    def require_object(self: DtoSchema, name: str, nested: DtoSchema) -> None:
        fields: list[Field] = self.fields
        fields.append(Field(name, "object", True, "", nested.name, ""))
        self.fields = fields
        self._flat.require(name, "object")
        nested_names: list[str] = self.nested_names
        nested_schemas: list[DtoSchema] = self.nested_schemas
        nested_names.append(name)
        nested_schemas.append(nested)
        self.nested_names = nested_names
        self.nested_schemas = nested_schemas

    def require_array(self: DtoSchema, name: str, item_kind: str) -> None:
        fields: list[Field] = self.fields
        fields.append(Field(name, "array", True, "", "", item_kind))
        self.fields = fields
        self._flat.require(name, "array")

    def flat(self: DtoSchema) -> Schema:
        return self._flat

def _object_get(v: JsonValue, key: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == key:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

def _matches_kind(v: JsonValue, kind: str) -> bool:
    if kind == "string":
        return nox.json.is_string(v)
    if kind == "number":
        return nox.json.is_number(v)
    if kind == "bool":
        return nox.json.is_bool(v)
    if kind == "array":
        return nox.json.is_array(v)
    if kind == "object":
        return nox.json.is_object(v)
    if kind == "null":
        return nox.json.is_null(v)
    return False

def _looks_email(s: str) -> bool:
    at: int = nox.strings.index_of(s, "@")
    if at <= 0:
        return False
    if at >= len(s) - 1:
        return False
    dot: int = nox.strings.index_of(_substr_from(s, at + 1), ".")
    return dot >= 0

def _substr_from(s: str, start: int) -> str:
    out: str = ""
    i: int = start
    while i < len(s):
        out = out + s[i]
        i = i + 1
    return out

def _looks_uri(s: str) -> bool:
    if nox.strings.starts_with(s, "http://"):
        return True
    if nox.strings.starts_with(s, "https://"):
        return True
    return False

def _check_format(field: Field, v: JsonValue) -> str:
    if len(field.format_name) == 0:
        return ""
    if field.kind != "string":
        return ""
    if not nox.json.is_string(v):
        return ""
    s: str = nox.json.as_string(v)
    if field.format_name == "email":
        if not _looks_email(s):
            return "alan '" + field.name + "' icin gecersiz email"
    if field.format_name == "uuid":
        if not nox.uuid.is_valid(s):
            return "alan '" + field.name + "' icin gecersiz uuid"
    if field.format_name == "uri":
        if not _looks_uri(s):
            return "alan '" + field.name + "' icin gecersiz uri"
    return ""

def validate_value(v: JsonValue, schema: DtoSchema) -> list[str]:
    errors: list[str] = nox.validate.validate(v, schema.flat())
    if len(errors) > 0:
        return errors
    i: int = 0
    while i < len(schema.nested_names):
        nest_name: str = schema.nested_names[i]
        nest_schema: DtoSchema = schema.nested_schemas[i]
        child: JsonValue | None = _object_get(v, nest_name)
        if child != None:
            nested_errors: list[str] = validate_value(child, nest_schema)
            j: int = 0
            while j < len(nested_errors):
                errors.append(nest_name + "." + nested_errors[j])
                j = j + 1
        i = i + 1
    i = 0
    while i < len(schema.fields):
        field: Field = schema.fields[i]
        got: JsonValue | None = _object_get(v, field.name)
        if got != None:
            g: JsonValue = got
            fmt_err: str = _check_format(field, g)
            if len(fmt_err) > 0:
                errors.append(fmt_err)
            if field.kind == "number" and nox.json.is_number(g):
                n: int = int(nox.json.as_number(g))
                if field.has_min and n < field.minimum:
                    errors.append("alan '" + field.name + "' minimum " + str(field.minimum))
                if field.has_max and n > field.maximum:
                    errors.append("alan '" + field.name + "' maximum " + str(field.maximum))
            if field.kind == "array" and len(field.item_kind) > 0:
                if nox.json.is_array(g):
                    n2: int = nox.json.array_len(g)
                    k: int = 0
                    while k < n2:
                        item: JsonValue = nox.json.array_get(g, k)
                        if not _matches_kind(item, field.item_kind):
                            errors.append(
                                "alan '" + field.name + "[" + str(k) + "]' icin beklenen tip: " + field.item_kind
                            )
                        k = k + 1
        i = i + 1
    return errors

def validate_json_str(raw: str, schema: DtoSchema) -> list[str]:
    try:
        v: JsonValue = nox.json.decode(raw)
        return validate_value(v, schema)
    except JsonError as e:
        errors: list[str] = []
        errors.append(e.message)
        return errors

def parse_or_raise(raw: str, schema: DtoSchema) -> str:
    errors: list[str] = validate_json_str(raw, schema)
    if len(errors) > 0:
        raise ValidationError("request body validation failed", errors)
    return raw + ""
