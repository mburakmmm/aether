# aether.rate_limit - in-process window with eviction.
#
# Keyed by HttpContext.client_ip() (socket peer, or the rightmost untrusted
# XFF hop from a listed proxy or CIDR).
# An empty key is rejected. Unknown clients do not skip the limiter and do
# not share one bucket.
# The serve handle must pass req.peer_addr into dispatch_from_parts.
# AETHER_RATE_LIMIT is installed before guards. A caller can still add
# rate_limit_interceptor() as a normal interceptor.
# Each limiter captures its own RateStore (not a process-global singleton).
# A full store refuses a new key. It does not drop a live counter.
# A known key is a dict lookup. Its own window resets in place.
# The full list is scanned only when a new key needs a free slot.
#
# Scope: worker-local. Nox module globals / Application boot are per worker slot,
# so each RateStore only sees traffic handled by that worker. With workers=N the
# effective process limit is roughly N × configured max (accept affinity can make
# it uneven). Use an external limiter for cluster-wide quotas.

import nox.time
from nox.http import HttpResponse
import aether.context
import aether.errors
import aether.interceptor
from aether.context import HttpContext
from aether.errors import TooManyRequestsError
from aether.interceptor import InterceptorFns

class RateBucket:
    key: str
    count: int
    window_start_ms: int

    def __init__(self: RateBucket, key: str, count: int, window_start_ms: int) -> None:
        self.key = key
        self.count = count
        self.window_start_ms = window_start_ms

class RateStore:
    buckets: list[RateBucket]
    # A missing key raises. The stored value is position+1 so 0 stays unused.
    index: dict[str, int]
    max_buckets: int

    def __init__(self: RateStore, max_buckets: int) -> None:
        self.buckets = []
        self.index = {}
        self.max_buckets = max_buckets

    def _reindex(self: RateStore) -> None:
        fresh: dict[str, int] = {}
        i: int = 0
        while i < len(self.buckets):
            fresh[self.buckets[i].key] = i + 1
            i = i + 1
        self.index = fresh

    def _find(self: RateStore, key: str) -> int:
        # A missing key raises. The hit path stays a dict lookup.
        slot: int = 0
        try:
            slot = self.index[key]
        except KeyError:
            return -1
        if slot <= 0:
            return -1
        pos: int = slot - 1
        if pos >= len(self.buckets):
            return -1
        if self.buckets[pos].key != key:
            return -1
        return pos

    def _evict_expired(self: RateStore, now: int, window_ms: int) -> None:
        fresh: list[RateBucket] = []
        i: int = 0
        while i < len(self.buckets):
            b: RateBucket = self.buckets[i]
            if now - b.window_start_ms < window_ms:
                fresh.append(b)
            i = i + 1
        self.buckets = fresh
        self._reindex()

    def allow(self: RateStore, key: str, max_n: int, window_ms: int) -> bool:
        now: int = nox.time.monotonic_ns() // 1000000
        pos: int = self._find(key)
        if pos >= 0:
            b: RateBucket = self.buckets[pos]
            if now - b.window_start_ms >= window_ms:
                b.count = 1
                b.window_start_ms = now
                return True
            if b.count >= max_n:
                return False
            b.count = b.count + 1
            return True
        # Sweep only to free a slot. A live counter is not dropped.
        if self.max_buckets > 0 and len(self.buckets) >= self.max_buckets:
            self._evict_expired(now, window_ms)
            if len(self.buckets) >= self.max_buckets:
                return False
        buckets: list[RateBucket] = self.buckets
        buckets.append(RateBucket(key, 1, now))
        self.buckets = buckets
        self.index[key] = len(self.buckets)
        return True

def _limiter(max_n: int, window_ms: int, max_buckets: int) -> InterceptorFns:
    store: RateStore = RateStore(max_buckets)

    def before(ctx: HttpContext) -> HttpResponse | None:
        key: str = ctx.client_ip()
        if len(key) == 0:
            raise TooManyRequestsError("rate limit exceeded")
        if not store.allow(key, max_n, window_ms):
            raise TooManyRequestsError("rate limit exceeded")
        return None

    def after(ctx: HttpContext, resp: HttpResponse) -> HttpResponse:
        return resp

    return InterceptorFns(before, after)

# Built-in AETHER_RATE_LIMIT. The cap is AETHER_RATE_LIMIT_MAX_BUCKETS.
def rate_limit_interceptor_capped(max_n: int, window_ms: int, max_buckets: int) -> InterceptorFns:
    return _limiter(max_n, window_ms, max_buckets)

# User interceptor. Keeps the previous two-argument call and a 10000 cap.
def rate_limit_interceptor(max_n: int, window_ms: int) -> InterceptorFns:
    return _limiter(max_n, window_ms, 10000)
