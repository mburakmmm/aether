# aether.rate_limit - in-process window with eviction.
#
# Keyed by HttpContext.client_ip() (socket peer, or XFF when trusted).
# An empty key skips the limiter so unknown clients do not share one bucket.
# The serve handle must pass req.peer_addr into dispatch_from_parts; bench
# handles pass "" and therefore do not rate-limit.
# Empty client_ip skips limiting (does NOT collapse into a shared "unknown" bucket).
# Each interceptor captures its own RateStore (not a process-global singleton).
#
# Scope: worker-local. Nox module globals / Application boot are per worker slot,
# so each RateStore only sees traffic handled by that worker. With workers=N the
# effective process limit is roughly N × configured max (accept affinity can make
# it uneven). Use an external limiter for cluster-wide quotas.

import nox.time
from nox.http import HttpResponse
import aether.context
import aether.errors
import aether.interceptor
from aether.context import HttpContext
from aether.errors import TooManyRequestsError
from aether.interceptor import InterceptorFns

class RateBucket:
    key: str
    count: int
    window_start_ms: int

    def __init__(self: RateBucket, key: str, count: int, window_start_ms: int) -> None:
        self.key = key
        self.count = count
        self.window_start_ms = window_start_ms

class RateStore:
    buckets: list[RateBucket]
    max_buckets: int

    def __init__(self: RateStore, max_buckets: int) -> None:
        self.buckets = []
        self.max_buckets = max_buckets

    def _evict_expired(self: RateStore, now: int, window_ms: int) -> None:
        fresh: list[RateBucket] = []
        i: int = 0
        while i < len(self.buckets):
            b: RateBucket = self.buckets[i]
            if now - b.window_start_ms < window_ms:
                fresh.append(b)
            i = i + 1
        self.buckets = fresh

    def allow(self: RateStore, key: str, max_n: int, window_ms: int) -> bool:
        now: int = nox.time.now_ms()
        self._evict_expired(now, window_ms)
        i: int = 0
        while i < len(self.buckets):
            b: RateBucket = self.buckets[i]
            if b.key == key:
                if now - b.window_start_ms >= window_ms:
                    b.count = 1
                    b.window_start_ms = now
                    return True
                if b.count >= max_n:
                    return False
                b.count = b.count + 1
                return True
            i = i + 1
        if self.max_buckets > 0 and len(self.buckets) >= self.max_buckets:
            # Drop oldest window to bound memory.
            drop: list[RateBucket] = []
            j: int = 1
            while j < len(self.buckets):
                drop.append(self.buckets[j])
                j = j + 1
            self.buckets = drop
        buckets: list[RateBucket] = self.buckets
        buckets.append(RateBucket(key, 1, now))
        self.buckets = buckets
        return True

def rate_limit_interceptor(max_n: int, window_ms: int) -> InterceptorFns:
    store: RateStore = RateStore(10000)

    def before(ctx: HttpContext) -> HttpResponse | None:
        key: str = ctx.client_ip()
        if len(key) == 0:
            # No peer identity - do not share a global "unknown" bucket.
            return None
        if not store.allow(key, max_n, window_ms):
            raise TooManyRequestsError("rate limit exceeded")
        return None

    def after(ctx: HttpContext, resp: HttpResponse) -> HttpResponse:
        return resp

    return InterceptorFns(before, after)
