# {{APP_NAME}} - Aether application

import nox.http
from nox.http import HttpRequest, HttpResponse
import aether.application
import aether.server
import aether.config
from aether.application import Application, EMPTY_HEADERS
from aether.config import Config
from aether.module import ModuleBuilder
from aether.context import HttpContext
from aether.response import json_ok

class RootModule:
    def configure(self: RootModule, m: ModuleBuilder) -> None:
        m.get("/", self._root())

    def _root(self: RootModule) -> (HttpContext) -> HttpResponse:
        def root(ctx: HttpContext) -> HttpResponse:
            return json_ok("{\"name\":\"{{APP_NAME}}\"}")
        return root

def build(app: Application) -> None:
    RootModule().configure(app.module())

cfg: Config = aether.config.load()
# Validates once; workers>1 clears parent AppBind (siblings boot via dispatch_ensure).
aether.application.boot_for_serve(cfg, build)

def handle(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch_from_parts(
        req.method, req.target, req.body, req.headers, cfg, build
    )

def handle_bare(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch_from_parts(
        req.method, req.target, req.body, EMPTY_HEADERS, cfg, build
    )

aether.server.print_listen(cfg, aether.server.serve_mode(cfg, False))
try:
    workers: int = aether.server.effective_workers(cfg)
    aether.server.apply_pool_workers(cfg)
    want_headers: bool = aether.server.materialize_request_headers(cfg)
    if aether.server.use_os_workers(cfg):
        if want_headers:
            nox.http.serve_multicore(cfg.port, handle, workers)
        else:
            nox.http.serve_multicore(cfg.port, handle_bare, workers)
    else:
        if want_headers:
            nox.http.serve(cfg.port, handle)
        else:
            nox.http.serve(cfg.port, handle_bare)
finally:
    aether.application.finalize_serve(cfg)
