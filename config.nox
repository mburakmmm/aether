# aether.config - AETHER_* environment configuration.

import nox.os
from nox.os import OsError

class ConfigError(Exception):
    def __init__(self: ConfigError, message: str) -> None:
        self.message = message

class Config:
    env: str
    host: str
    port: int
    workers: int
    log_requests: bool
    openapi_enabled: bool
    openapi_title: str
    openapi_version: str
    jobs_db_path: str
    tls_cert_path: str
    tls_key_path: str
    trust_x_forwarded_for: bool
    ws_enabled: bool
    max_body_bytes: int
    rate_limit_enabled: bool
    rate_limit_max: int
    rate_limit_window_ms: int
    cors_origins: str
    job_stale_ms: int
    metrics_routes: bool

    def __init__(
        self: Config,
        env: str,
        host: str,
        port: int,
        workers: int,
        log_requests: bool,
        openapi_enabled: bool,
        openapi_title: str,
        openapi_version: str,
        jobs_db_path: str,
        tls_cert_path: str,
        tls_key_path: str,
        trust_x_forwarded_for: bool,
        ws_enabled: bool,
        max_body_bytes: int,
        rate_limit_enabled: bool,
        rate_limit_max: int,
        rate_limit_window_ms: int,
        cors_origins: str,
        job_stale_ms: int,
        metrics_routes: bool
    ) -> None:
        self.env = env
        self.host = host
        self.port = port
        self.workers = workers
        self.log_requests = log_requests
        self.openapi_enabled = openapi_enabled
        self.openapi_title = openapi_title
        self.openapi_version = openapi_version
        self.jobs_db_path = jobs_db_path
        self.tls_cert_path = tls_cert_path
        self.tls_key_path = tls_key_path
        self.trust_x_forwarded_for = trust_x_forwarded_for
        self.ws_enabled = ws_enabled
        self.max_body_bytes = max_body_bytes
        self.rate_limit_enabled = rate_limit_enabled
        self.rate_limit_max = rate_limit_max
        self.rate_limit_window_ms = rate_limit_window_ms
        self.cors_origins = cors_origins
        self.job_stale_ms = job_stale_ms
        self.metrics_routes = metrics_routes

    def is_development(self: Config) -> bool:
        return self.env == "development"

    def is_test(self: Config) -> bool:
        return self.env == "test"

    def is_production(self: Config) -> bool:
        return self.env == "production"

    def has_tls(self: Config) -> bool:
        return len(self.tls_cert_path) > 0 and len(self.tls_key_path) > 0

def _env_or(name: str, default: str) -> str:
    try:
        return nox.os.getenv(name)
    except OsError:
        return default

def _env_int(name: str, default: int) -> int:
    raw: str = _env_or(name, "")
    if len(raw) == 0:
        return default
    return int(raw)

def _env_bool(name: str, default: bool) -> bool:
    raw: str = _env_or(name, "")
    if len(raw) == 0:
        return default
    if raw == "1" or raw == "true" or raw == "TRUE" or raw == "yes" or raw == "on":
        return True
    if raw == "0" or raw == "false" or raw == "FALSE" or raw == "no" or raw == "off":
        return False
    return default

def _validate_env(env: str) -> None:
    if env != "development" and env != "test" and env != "production":
        raise ConfigError("invalid AETHER_ENV: " + env + " (development|test|production)")

def defaults(env: str) -> Config:
    _validate_env(env)
    log_req: bool = True
    workers: int = 1
    jobs: str = "db/jobs.sqlite"
    openapi_on: bool = True
    rate_on: bool = False
    cors: str = "*"
    metrics_routes: bool = True
    if env == "test":
        log_req = False
        jobs = ":memory:"
        rate_on = False
    if env == "production":
        workers = 1
        openapi_on = False
        rate_on = False
        # Opt-in like rate limit: avoid per-request CORS cost unless configured.
        cors = ""
        metrics_routes = False
    return Config(
        env,
        "0.0.0.0",
        3000,
        workers,
        log_req,
        openapi_on,
        "Aether API",
        "0.4.4",
        jobs,
        "",
        "",
        False,
        False,
        1048576,
        rate_on,
        100,
        60000,
        cors,
        300000,
        metrics_routes
    )

def from_env() -> Config:
    env: str = _env_or("AETHER_ENV", "development")
    cfg: Config = defaults(env)
    cfg.host = _env_or("AETHER_HOST", cfg.host)
    cfg.port = _env_int("AETHER_PORT", cfg.port)
    cfg.workers = _env_int("AETHER_WORKERS", cfg.workers)
    cfg.log_requests = _env_bool("AETHER_LOG_REQUESTS", cfg.log_requests)
    cfg.openapi_enabled = _env_bool("AETHER_OPENAPI", cfg.openapi_enabled)
    cfg.openapi_title = _env_or("AETHER_OPENAPI_TITLE", cfg.openapi_title)
    cfg.openapi_version = _env_or("AETHER_OPENAPI_VERSION", cfg.openapi_version)
    cfg.jobs_db_path = _env_or("AETHER_JOBS_DB", cfg.jobs_db_path)
    cfg.tls_cert_path = _env_or("AETHER_TLS_CERT", cfg.tls_cert_path)
    cfg.tls_key_path = _env_or("AETHER_TLS_KEY", cfg.tls_key_path)
    cfg.trust_x_forwarded_for = _env_bool("AETHER_TRUST_X_FORWARDED_FOR", cfg.trust_x_forwarded_for)
    cfg.ws_enabled = _env_bool("AETHER_WS", cfg.ws_enabled)
    cfg.max_body_bytes = _env_int("AETHER_MAX_BODY_BYTES", cfg.max_body_bytes)
    cfg.rate_limit_enabled = _env_bool("AETHER_RATE_LIMIT", cfg.rate_limit_enabled)
    cfg.rate_limit_max = _env_int("AETHER_RATE_LIMIT_MAX", cfg.rate_limit_max)
    cfg.rate_limit_window_ms = _env_int("AETHER_RATE_LIMIT_WINDOW_MS", cfg.rate_limit_window_ms)
    cfg.cors_origins = _env_or("AETHER_CORS_ORIGINS", cfg.cors_origins)
    cfg.job_stale_ms = _env_int("AETHER_JOB_STALE_MS", cfg.job_stale_ms)
    cfg.metrics_routes = _env_bool("AETHER_METRICS_ROUTES", cfg.metrics_routes)
    return cfg

def load() -> Config:
    return from_env()
