# Worker / AppBind probe — proves Application / module-global locality.
#
# build() mints a boot_id into module-global BootBox.
# GET /__worker returns it. Under workers>1 + per-worker globals,
# parallel hits should observe multiple distinct boot_ids.
#
# AETHER_PROBE_SKIP_PARENT_BOOT=1 skips boot_with_config before serve so every
# worker must boot via dispatch_ensure on first request.

import nox.http
import nox.uuid
import nox.os
import nox.fs
from nox.os import OsError
from nox.http import HttpRequest, HttpResponse
import aether.application
import aether.server
import aether.config
from aether.application import Application, EMPTY_HEADERS
from aether.config import Config
from aether.module import ModuleBuilder
from aether.context import HttpContext
from aether.response import json_ok

class BootBox:
    ids: list[str]
    builds: int

    def __init__(self: BootBox) -> None:
        self.ids = []
        self.builds = 0

_BOOT: BootBox = BootBox()

def ping_handler(ctx: HttpContext) -> HttpResponse:
    return json_ok("{\"pong\":true}")

def worker_handler(ctx: HttpContext) -> HttpResponse:
    if len(_BOOT.ids) == 0:
        return json_ok("{\"boot_id\":\"missing\",\"builds\":0}")
    return json_ok(
        "{\"boot_id\":\"" + _BOOT.ids[0] + "\",\"builds\":" + str(_BOOT.builds) + "}"
    )

def build(app: Application) -> None:
    ids: list[str] = []
    bid: str = nox.uuid.uuid4()
    ids.append(bid)
    _BOOT.ids = ids
    _BOOT.builds = _BOOT.builds + 1
    # Durable side-effect: one file per build (survives stdout buffering).
    marker: str = "/tmp/aether-boot-markers/" + bid + ".boot"
    nox.fs.write_string(marker, "builds=" + str(_BOOT.builds) + "\n")
    nox.fs.append_string("/tmp/aether-boot-markers/builds.log", bid + "\n")
    m: ModuleBuilder = app.module()
    m.get("/ping", ping_handler)
    m.get("/__worker", worker_handler)

def _env_flag(name: str) -> bool:
    try:
        v: str = nox.os.getenv(name)
        return v == "1" or v == "true" or v == "TRUE"
    except OsError:
        return False

cfg: Config = aether.config.load()
if _env_flag("AETHER_PROBE_SKIP_PARENT_BOOT"):
    print("aether worker_probe skip_parent_boot=1")
else:
    app: Application = aether.application.boot_with_config(cfg, build)

def handle(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch_from_parts(
        req.method, req.target, req.body, req.headers, cfg, build
    )

def handle_bare(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch_from_parts(
        req.method, req.target, req.body, EMPTY_HEADERS, cfg, build
    )

aether.server.print_listen(cfg, aether.server.serve_mode(cfg, False))
try:
    workers: int = aether.server.effective_workers(cfg)
    aether.server.apply_pool_workers(cfg)
    want_headers: bool = aether.server.materialize_request_headers(cfg)
    if aether.server.use_os_workers(cfg):
        if want_headers:
            nox.http.serve_multicore(cfg.port, handle, workers)
        else:
            nox.http.serve_multicore(cfg.port, handle_bare, workers)
    else:
        if want_headers:
            nox.http.serve(cfg.port, handle)
        else:
            nox.http.serve(cfg.port, handle_bare)
finally:
    aether.application.shutdown_bound()
