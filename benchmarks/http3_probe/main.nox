# Single-worker TLS ping with HTTP/3 enabled. QUIC is one UDP socket.
# peer_addr stays empty on HTTP/3. WebSocket stays off.

import nox.http
from nox.http import HttpRequest, HttpResponse
import aether.application
import aether.server
import aether.config
from aether.application import Application
from aether.config import Config
from aether.module import ModuleBuilder
from aether.context import HttpContext
from aether.response import json_ok

def who(ctx: HttpContext) -> HttpResponse:
    seen: str = ctx.get_request_value("aether.jwt")
    if ctx.header("x-mark") == "1":
        ctx.set_request_value("aether.jwt", "secret-token")
    peer: str = ctx.request.peer_addr
    return json_ok("{\"saw\":\"" + seen + "\",\"peer\":\"" + peer + "\"}")

def build(app: Application) -> None:
    m: ModuleBuilder = app.module()
    m.get("/who", who)

cfg: Config = aether.config.load()
cfg.workers = 1
cfg.ws_enabled = False
cfg.http3 = True
cfg.rate_limit_enabled = False
aether.application.boot_for_serve(cfg, build)

def handle(req: HttpRequest) -> HttpResponse:
    return aether.application.dispatch_from_parts(
        req.method, req.target, req.body, req.headers, req.peer_addr, cfg, build, req.conn
    )

aether.server.print_listen(cfg, "tls")
try:
    nox.http.serve_tls(cfg.port, handle, cfg.tls_cert_path, cfg.tls_key_path)
finally:
    aether.application.finalize_serve(cfg)
