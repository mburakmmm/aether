# aether.openapi - OpenAPI 3 with nested $ref components + success status.

import nox.json
import nox.strings
import aether.module
import aether.dto
import aether.config
from aether.module import RouteDef
from aether.dto import DtoSchema, Field
from aether.config import Config

def _field_schema_json(field: Field, nested_ref: bool) -> str:
    if field.kind == "object" and len(field.description) > 0 and nested_ref:
        return "{\"$ref\":\"#/components/schemas/" + field.description + "\"}"
    body: str = "{\"type\":" + nox.json.encode_string(field.kind)
    if len(field.format_name) > 0:
        body = body + ",\"format\":" + nox.json.encode_string(field.format_name)
    if field.kind == "number":
        if field.has_min:
            body = body + ",\"minimum\":" + str(field.minimum)
        if field.has_max:
            body = body + ",\"maximum\":" + str(field.maximum)
    if field.kind == "array" and len(field.item_kind) > 0:
        body = body + ",\"items\":{\"type\":" + nox.json.encode_string(field.item_kind) + "}"
    body = body + "}"
    return body

def _dto_schema_json(schema: DtoSchema) -> str:
    props: str = "{"
    required: list[str] = []
    i: int = 0
    while i < len(schema.fields):
        field: Field = schema.fields[i]
        if i > 0:
            props = props + ","
        props = props + nox.json.encode_string(field.name) + ":" + _field_schema_json(field, True)
        if field.required:
            required.append(field.name)
        i = i + 1
    props = props + "}"
    body: str = "{\"type\":\"object\",\"properties\":" + props
    if len(required) > 0:
        body = body + ",\"required\":["
        j: int = 0
        while j < len(required):
            if j > 0:
                body = body + ","
            body = body + nox.json.encode_string(required[j])
            j = j + 1
        body = body + "]"
    body = body + "}"
    return body

def _has_name(names: list[str], name: str) -> bool:
    i: int = 0
    while i < len(names):
        if names[i] == name:
            return True
        i = i + 1
    return False

def _collect_schemas(routes: list[RouteDef]) -> list[DtoSchema]:
    # Iterative BFS - Nox codegen rejects some recursive helpers.
    out: list[DtoSchema] = []
    names: list[str] = []
    queue: list[DtoSchema] = []
    ri: int = 0
    while ri < len(routes):
        r: RouteDef = routes[ri]
        if r.has_input and len(r.input_schema.name) > 0:
            if not _has_name(names, r.input_schema.name):
                names.append(r.input_schema.name)
                out.append(r.input_schema)
                queue.append(r.input_schema)
        if r.has_output and len(r.output_schema.name) > 0:
            if not _has_name(names, r.output_schema.name):
                names.append(r.output_schema.name)
                out.append(r.output_schema)
                queue.append(r.output_schema)
        ri = ri + 1
    qi: int = 0
    while qi < len(queue):
        schema: DtoSchema = queue[qi]
        ni: int = 0
        while ni < len(schema.nested_schemas):
            nest: DtoSchema = schema.nested_schemas[ni]
            if len(nest.name) > 0 and not _has_name(names, nest.name):
                names.append(nest.name)
                out.append(nest)
                queue.append(nest)
            ni = ni + 1
        qi = qi + 1
    return out

def _components_json(schemas: list[DtoSchema]) -> str:
    body: str = "{\"schemas\":{"
    i: int = 0
    while i < len(schemas):
        if i > 0:
            body = body + ","
        s: DtoSchema = schemas[i]
        body = body + nox.json.encode_string(s.name) + ":" + _dto_schema_json(s)
        i = i + 1
    body = body + "}"
    body = body + ",\"securitySchemes\":{"
    body = body + "\"bearerAuth\":{\"type\":\"http\",\"scheme\":\"bearer\",\"bearerFormat\":\"JWT\"}"
    body = body + ",\"apiKeyAuth\":{\"type\":\"apiKey\",\"in\":\"header\",\"name\":\"X-API-Key\"}"
    body = body + "}}"
    return body

def _path_params_json(pattern: str) -> str:
    parts: list[str] = nox.strings.split(pattern, "/")
    out: str = "["
    first: bool = True
    i: int = 0
    while i < len(parts):
        p: str = parts[i]
        if nox.strings.starts_with(p, ":"):
            name: str = ""
            k: int = 1
            while k < len(p):
                name = name + p[k]
                k = k + 1
            if not first:
                out = out + ","
            first = False
            out = out + "{\"name\":" + nox.json.encode_string(name)
            out = out + ",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}"
        i = i + 1
    out = out + "]"
    return out

def _schema_ref_or_inline(schema: DtoSchema) -> str:
    if len(schema.name) > 0:
        return "{\"$ref\":\"#/components/schemas/" + schema.name + "\"}"
    return _dto_schema_json(schema)

def _method_key(method: str) -> str:
    if method == "GET":
        return "get"
    if method == "POST":
        return "post"
    if method == "PUT":
        return "put"
    if method == "DELETE":
        return "delete"
    return "get"

def _operation_json(route: RouteDef) -> str:
    body: str = "{"
    if len(route.summary) > 0:
        body = body + "\"summary\":" + nox.json.encode_string(route.summary) + ","
    if len(route.tag) > 0:
        body = body + "\"tags\":[" + nox.json.encode_string(route.tag) + "],"
    params: str = _path_params_json(route.pattern)
    if params != "[]":
        body = body + "\"parameters\":" + params + ","
    if route.has_input:
        body = body + "\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":"
        body = body + _schema_ref_or_inline(route.input_schema) + "}}},"
    status_key: str = str(route.success_status)
    body = body + "\"responses\":{"
    body = body + nox.json.encode_string(status_key) + ":{\"description\":\"OK\""
    if route.has_output:
        body = body + ",\"content\":{\"application/json\":{\"schema\":" + _schema_ref_or_inline(route.output_schema) + "}}"
    body = body + "}"
    body = body + ",\"400\":{\"description\":\"Bad Request\"}"
    body = body + ",\"401\":{\"description\":\"Unauthorized\"}"
    body = body + ",\"403\":{\"description\":\"Forbidden\"}"
    body = body + ",\"404\":{\"description\":\"Not Found\"}"
    body = body + ",\"422\":{\"description\":\"Validation Error\"}"
    body = body + ",\"500\":{\"description\":\"Internal Error\"}"
    body = body + "}"
    body = body + "}"
    return body

def _openapi_path(pattern: str) -> str:
    parts: list[str] = nox.strings.split(pattern, "/")
    out: str = ""
    i: int = 0
    while i < len(parts):
        p: str = parts[i]
        if i > 0 or len(p) > 0:
            out = out + "/"
        if nox.strings.starts_with(p, ":"):
            name: str = ""
            k: int = 1
            while k < len(p):
                name = name + p[k]
                k = k + 1
            out = out + "{" + name + "}"
        else:
            out = out + p
        i = i + 1
    if len(out) == 0:
        return "/"
    return out

def build_document(cfg: Config, routes: list[RouteDef]) -> str:
    schemas: list[DtoSchema] = _collect_schemas(routes)
    paths_json: str = "{"
    emitted: list[str] = []
    pi: int = 0
    first_path: bool = True
    while pi < len(routes):
        route: RouteDef = routes[pi]
        opath: str = _openapi_path(route.pattern)
        seen: bool = False
        s: int = 0
        while s < len(emitted):
            if emitted[s] == opath:
                seen = True
            s = s + 1
        if not seen:
            if not first_path:
                paths_json = paths_json + ","
            first_path = False
            paths_json = paths_json + nox.json.encode_string(opath) + ":{"
            first_op: bool = True
            rj: int = 0
            while rj < len(routes):
                r2: RouteDef = routes[rj]
                if _openapi_path(r2.pattern) == opath:
                    if not first_op:
                        paths_json = paths_json + ","
                    first_op = False
                    paths_json = paths_json + nox.json.encode_string(_method_key(r2.method)) + ":" + _operation_json(r2)
                rj = rj + 1
            paths_json = paths_json + "}"
            emitted.append(opath)
        pi = pi + 1
    paths_json = paths_json + "}"
    doc: str = "{"
    doc = doc + "\"openapi\":\"3.0.3\","
    doc = doc + "\"info\":{\"title\":" + nox.json.encode_string(cfg.openapi_title)
    doc = doc + ",\"version\":" + nox.json.encode_string(cfg.openapi_version) + "},"
    doc = doc + "\"paths\":" + paths_json + ","
    doc = doc + "\"components\":" + _components_json(schemas)
    doc = doc + "}"
    return doc
