# aether.logx - structured JSON log lines for Aether apps.

import nox.json
import nox.log
import aether.context

def request_fields(extra: dict[str, str]) -> str:
    body: str = "{"
    body = body + "\"request_id\":" + nox.json.encode_string(aether.context.current_request_id())
    keys: list[str] = extra.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        body = body + "," + nox.json.encode_string(k) + ":" + nox.json.encode_string(extra[k])
        i = i + 1
    body = body + "}"
    return body

def info(event: str, extra: dict[str, str]) -> None:
    fields: dict[str, str] = {}
    keys: list[str] = extra.keys()
    i: int = 0
    while i < len(keys):
        fields[keys[i]] = extra[keys[i]]
        i = i + 1
    fields["event"] = event
    nox.log.info(request_fields(fields))

def error(event: str, extra: dict[str, str]) -> None:
    fields: dict[str, str] = {}
    keys: list[str] = extra.keys()
    i: int = 0
    while i < len(keys):
        fields[keys[i]] = extra[keys[i]]
        i = i + 1
    fields["event"] = event
    nox.log.error(request_fields(fields))
