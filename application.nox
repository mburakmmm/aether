# aether.application - boot, dispatch, lifecycle, filters, hardening.

import nox.uuid
import nox.log
import nox.time
from nox.http import HttpRequest, HttpResponse
import aether.config
import aether.container
import aether.context
import aether.module
import aether.pipeline
import aether.errors
import aether.response
import aether.openapi
import aether.interceptor
import aether.cors
import aether.rate_limit
import aether.metrics
import aether.swagger
from aether.config import Config
from aether.container import Container
from aether.context import HttpContext, begin, finish, path_only, normalize_path
from aether.module import ModuleBuilder, RouteDef, RouteTable, HookState, rebuild_route_index
from aether.pipeline import MatchResult, find_route_indexed, path_exists, execute
from aether.errors import HttpError, NotFoundError, MethodNotAllowedError, PayloadTooLargeError, error_json
from aether.interceptor import InterceptorFns
from aether.dto import DtoSchema, Field
from aether.metrics import Metrics

class AppError(Exception):
    def __init__(self: AppError, message: str) -> None:
        self.message = message

class Application:
    config: Config
    container: Container
    route_table: RouteTable
    hooks: HookState
    _shutdown_hooks: list[() -> None]
    openapi_doc: str
    metrics: Metrics
    _closed: bool

    def __init__(
        self: Application,
        cfg: Config,
        container: Container,
        route_table: RouteTable,
        hooks: HookState,
        shutdown_hooks: list[() -> None],
        openapi_doc: str,
        metrics: Metrics
    ) -> None:
        self.config = cfg
        self.container = container
        self.route_table = route_table
        self.hooks = hooks
        self._shutdown_hooks = shutdown_hooks
        self.openapi_doc = openapi_doc
        self.metrics = metrics
        self._closed = False

    def module(self: Application) -> ModuleBuilder:
        return ModuleBuilder(self.route_table, self.container, self.hooks)

    def import_configure(self: Application, configure: (ModuleBuilder) -> None) -> None:
        configure(self.module())

    def import_module(self: Application, configure: (ModuleBuilder) -> None) -> None:
        configure(self.module())

    def on_shutdown(self: Application, hook: () -> None) -> None:
        hooks: list[() -> None] = self._shutdown_hooks
        hooks.append(hook)
        self._shutdown_hooks = hooks

    def use_exception_filter(self: Application, filt: (HttpError) -> HttpResponse | None) -> None:
        hooks: HookState = self.hooks
        fs: list[(HttpError) -> HttpResponse | None] = hooks.exception_filters
        fs.append(filt)
        hooks.exception_filters = fs

def _mount_framework_routes(app: Application) -> None:
    empty: DtoSchema = DtoSchema("")

    def health(ctx: HttpContext) -> HttpResponse:
        return aether.response.json_ok("{\"status\":\"ok\"}")

    def openapi_handler(ctx: HttpContext) -> HttpResponse:
        return aether.response.json_ok(app.openapi_doc + "")

    def metrics_handler(ctx: HttpContext) -> HttpResponse:
        return aether.response.json_ok(app.metrics.to_json())

    def docs_handler(ctx: HttpContext) -> HttpResponse:
        return aether.swagger.html_page(app.config.openapi_title + "")

    table: RouteTable = app.route_table
    routes: list[RouteDef] = table.routes
    routes.append(RouteDef("GET", "/health", health, "Health check", "system", False, empty, False, empty, 200))
    routes.append(RouteDef("GET", "/metrics", metrics_handler, "Metrics", "system", False, empty, False, empty, 200))
    if app.config.openapi_enabled:
        routes.append(
            RouteDef("GET", "/openapi.json", openapi_handler, "OpenAPI document", "system", False, empty, False, empty, 200)
        )
        routes.append(
            RouteDef("GET", "/docs", docs_handler, "Swagger UI", "system", False, empty, False, empty, 200)
        )
    table.routes = routes

def _route_key(method: str, pattern: str) -> str:
    return method + " " + pattern

def _schema_fingerprint(schema: DtoSchema) -> str:
    # Structural identity for OpenAPI component name collisions.
    out: str = schema.name
    fi: int = 0
    while fi < len(schema.fields):
        f: Field = schema.fields[fi]
        out = out + "|" + f.name + ":" + f.kind + ":" + str(f.required) + ":" + f.format_name
        out = out + ":" + f.item_kind + ":" + str(f.has_min) + ":" + str(f.minimum)
        out = out + ":" + str(f.has_max) + ":" + str(f.maximum)
        fi = fi + 1
    ni: int = 0
    while ni < len(schema.nested_schemas):
        nest: DtoSchema = schema.nested_schemas[ni]
        out = out + ">nested:" + nest.name
        ni = ni + 1
    return out

def _validate_schema_names(routes: list[RouteDef]) -> None:
    # Iterative - avoid recursive helpers (Nox codegen limits).
    seen_names: list[str] = []
    seen_fps: list[str] = []
    queue: list[DtoSchema] = []
    i: int = 0
    while i < len(routes):
        r: RouteDef = routes[i]
        if r.has_input and len(r.input_schema.name) > 0:
            queue.append(r.input_schema)
        if r.has_output and len(r.output_schema.name) > 0:
            queue.append(r.output_schema)
        i = i + 1
    qi: int = 0
    while qi < len(queue):
        schema: DtoSchema = queue[qi]
        name: str = schema.name
        fp: str = _schema_fingerprint(schema)
        k: int = 0
        found: bool = False
        while k < len(seen_names):
            if seen_names[k] == name:
                found = True
                if seen_fps[k] != fp:
                    raise AppError(
                        "duplicate DTO schema name with different shape: " + name
                    )
            k = k + 1
        if not found:
            seen_names.append(name)
            seen_fps.append(fp)
            ni: int = 0
            while ni < len(schema.nested_schemas):
                nest: DtoSchema = schema.nested_schemas[ni]
                if len(nest.name) > 0:
                    queue.append(nest)
                ni = ni + 1
        qi = qi + 1

def _validate_boot(app: Application) -> None:
    # Call after _mount_framework_routes so /health|/metrics|/docs|/openapi.json
    # collide with user routes at boot instead of silently double-registering.
    routes: list[RouteDef] = app.route_table.routes
    seen_routes: list[str] = []
    i: int = 0
    while i < len(routes):
        r: RouteDef = routes[i]
        key: str = _route_key(r.method, r.pattern)
        j: int = 0
        while j < len(seen_routes):
            if seen_routes[j] == key:
                raise AppError("duplicate route: " + key)
            j = j + 1
        seen_routes.append(key)
        i = i + 1
    _validate_schema_names(routes)

def boot(build: (Application) -> None) -> Application:
    cfg: Config = aether.config.load()
    return boot_with_config(cfg, build)

def boot_with_config(cfg: Config, build: (Application) -> None) -> Application:
    container: Container = Container()
    table: RouteTable = RouteTable()
    hooks: HookState = HookState()
    xs: list[InterceptorFns] = hooks.interceptors
    if cfg.rate_limit_enabled:
        xs.append(aether.rate_limit.rate_limit_interceptor(cfg.rate_limit_max, cfg.rate_limit_window_ms))
    hooks.interceptors = xs
    shutdown_hooks: list[() -> None] = []
    app: Application = Application(cfg, container, table, hooks, shutdown_hooks, "{}", Metrics())
    build(app)
    _mount_framework_routes(app)
    _validate_boot(app)
    app.openapi_doc = aether.openapi.build_document(cfg, app.route_table.routes)
    rebuild_route_index(app.route_table)
    bind(app)
    return app

def _apply_filters(app: Application, err: HttpError) -> HttpResponse | None:
    i: int = 0
    while i < len(app.hooks.exception_filters):
        filt: (HttpError) -> HttpResponse | None = app.hooks.exception_filters[i]
        out: HttpResponse | None = filt(err)
        if out != None:
            return out
        i = i + 1
    return None

def _error_response(cfg: Config, err: HttpError, kind: str) -> HttpResponse:
    include_kind: bool = cfg.is_development() or cfg.is_test()
    body: str = error_json(err, include_kind, kind)
    return aether.response.json(err.status, body)

def _finalize_response(app: Application, req: HttpRequest, rid: str, resp: HttpResponse) -> HttpResponse:
    # Always-on finalizers (error and success paths). One header-map copy.
    extra: dict[str, str] = {}
    extra["X-Request-Id"] = rid + ""
    cors_cfg: str = app.config.cors_origins
    if len(cors_cfg) > 0:
        origin: str = ""
        if cors_cfg != "*":
            origin = aether.cors.read_origin(req)
        allow: str = aether.cors.allow_origin_header(cors_cfg, origin)
        if len(allow) > 0:
            extra["Access-Control-Allow-Origin"] = allow
            extra["Vary"] = "Origin"
    return aether.response.with_headers(resp, extra)

def _complete_request(
    app: Application,
    req: HttpRequest,
    rid: str,
    path: str,
    route_key: str,
    started: int,
    resp: HttpResponse
) -> HttpResponse:
    out: HttpResponse = _finalize_response(app, req, rid, resp)
    app.metrics.record(out.status)
    if app.config.metrics_routes and len(route_key) > 0:
        app.metrics.record_route_key(route_key)
    if app.config.log_requests:
        elapsed: int = nox.time.now_ms() - started
        nox.log.info(
            req.method + " " + path + " -> " + str(out.status) + " " + str(elapsed) + "ms id=" + rid
        )
    return out

def dispatch(app: Application, req: HttpRequest) -> HttpResponse:
    rid: str = nox.uuid.uuid4()
    path: str = normalize_path(path_only(req.target))
    begin(rid, req.method, path)
    started: int = nox.time.now_ms()
    resp_opt: HttpResponse | None = None
    # Metrics key uses route pattern (not raw path) to bound cardinality.
    route_key: str = ""
    try:
        try:
            if app.config.max_body_bytes > 0 and len(req.body) > app.config.max_body_bytes:
                raise PayloadTooLargeError("request body too large")
            if req.method == "OPTIONS" and len(app.config.cors_origins) > 0:
                origin: str = ""
                if app.config.cors_origins != "*":
                    origin = aether.cors.read_origin(req)
                resp_opt = aether.cors.preflight_response(app.config.cors_origins, origin)
            else:
                matched: MatchResult | None = find_route_indexed(app.route_table, req.method, path)
                if matched == None:
                    if path_exists(app.route_table.routes, path):
                        raise MethodNotAllowedError("method not allowed: " + req.method + " " + path)
                    raise NotFoundError("route not found: " + req.method + " " + path)
                else:
                    hit: MatchResult = matched
                    route_key = hit.route.method + " " + hit.route.pattern
                    ctx: HttpContext = HttpContext(
                        req,
                        hit.params,
                        app.container,
                        rid,
                        "",
                        app.config.trust_x_forwarded_for
                    )
                    resp_opt = execute(
                        hit.route,
                        ctx,
                        app.hooks.guards,
                        app.hooks.pipes,
                        app.hooks.interceptors
                    )
        except HttpError as e:
            filtered: HttpResponse | None = _apply_filters(app, e)
            if filtered != None:
                resp_opt = filtered
            else:
                resp_opt = _error_response(app.config, e, "HttpError")
        except Exception as e:
            msg: str = e.message
            if not app.config.is_production():
                internal: HttpError = HttpError(500, "internal_error", msg, [])
                resp_opt = _error_response(app.config, internal, "Exception")
            else:
                internal2: HttpError = HttpError(500, "internal_error", "internal server error", [])
                resp_opt = _error_response(app.config, internal2, "Exception")
    finally:
        finish()
    if resp_opt == None:
        unset: HttpResponse = _error_response(
            app.config,
            HttpError(500, "internal_error", "unset response", []),
            "HttpError"
        )
        return _complete_request(app, req, rid, path, route_key, started, unset)
    else:
        return _complete_request(app, req, rid, path, route_key, started, resp_opt)

# Serve handlers must not close over Application directly — Nox codegen rejects
# that combination. Prefer dispatch_bound() after boot (boot auto-bind) or bind().
class AppBind:
    apps: list[Application]

    def __init__(self: AppBind) -> None:
        self.apps = []

_bind: AppBind = AppBind()

def bind(app: Application) -> None:
    xs: list[Application] = []
    xs.append(app)
    _bind.apps = xs

def bound() -> Application:
    if len(_bind.apps) == 0:
        raise AppError("call aether.application.bind(app) before dispatch_bound")
    return _bind.apps[0]

def dispatch_bound(req: HttpRequest) -> HttpResponse:
    return dispatch(bound(), req)

def shutdown(app: Application) -> None:
    if app._closed:
        return
    app._closed = True
    i: int = 0
    while i < len(app._shutdown_hooks):
        hook: () -> None = app._shutdown_hooks[i]
        try:
            hook()
        except Exception as e:
            nox.log.error("shutdown hook failed: " + e.message)
        i = i + 1

def shutdown_bound() -> None:
    if len(_bind.apps) > 0:
        shutdown(_bind.apps[0])
