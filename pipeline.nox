# aether.pipeline - path match + 405 + Guard -> Pipe -> Interceptor -> Handler.

import nox.strings
from nox.http import HttpResponse
import aether.context
import aether.guard
import aether.pipe
import aether.interceptor
import aether.module
from aether.context import HttpContext, normalize_path
from aether.guard import run_guards
from aether.pipe import run_pipes
from aether.interceptor import InterceptorFns, BeforeResult, run_before, run_after
from aether.module import RouteDef, RouteTable

def _drop_first_char(s: str) -> str:
    result: str = ""
    i: int = 1
    while i < len(s):
        result = result + s[i]
        i = i + 1
    return result

def match_path(pattern: str, target: str) -> dict[str, str] | None:
    pattern_parts: list[str] = nox.strings.split(pattern, "/")
    target_parts: list[str] = nox.strings.split(target, "/")
    if len(pattern_parts) != len(target_parts):
        return None
    params: dict[str, str] = {}
    i: int = 0
    while i < len(pattern_parts):
        p: str = pattern_parts[i]
        t: str = target_parts[i]
        if nox.strings.starts_with(p, ":"):
            name: str = _drop_first_char(p)
            params[name] = t
        else:
            if p != t:
                return None
        i = i + 1
    return params

class MatchResult:
    route: RouteDef
    params: dict[str, str]

    def __init__(self: MatchResult, route: RouteDef, params: dict[str, str]) -> None:
        self.route = route
        self.params = params

def _find_in(routes: list[RouteDef], path: str) -> MatchResult | None:
    i: int = 0
    while i < len(routes):
        route: RouteDef = routes[i]
        params: dict[str, str] | None = match_path(route.pattern, path)
        if params != None:
            return MatchResult(route, params)
        i = i + 1
    return None

def find_route(routes: list[RouteDef], method: str, path: str) -> MatchResult | None:
    # Legacy full-list scan (tests / callers without RouteTable index).
    norm: str = normalize_path(path)
    i: int = 0
    while i < len(routes):
        route: RouteDef = routes[i]
        if route.method == method:
            params: dict[str, str] | None = match_path(route.pattern, norm)
            if params != None:
                return MatchResult(route, params)
        i = i + 1
    return None

def find_route_indexed(table: RouteTable, method: str, path: str) -> MatchResult | None:
    norm: str = normalize_path(path)
    if method == "GET":
        return _find_in(table.get_routes, norm)
    if method == "POST":
        return _find_in(table.post_routes, norm)
    if method == "PUT":
        return _find_in(table.put_routes, norm)
    if method == "DELETE":
        return _find_in(table.delete_routes, norm)
    return _find_in(table.other_routes, norm)

def path_exists(routes: list[RouteDef], path: str) -> bool:
    norm: str = normalize_path(path)
    i: int = 0
    while i < len(routes):
        params: dict[str, str] | None = match_path(routes[i].pattern, norm)
        if params != None:
            return True
        i = i + 1
    return False

def execute(
    route: RouteDef,
    ctx: HttpContext,
    global_guards: list[(HttpContext) -> bool],
    global_pipes: list[(HttpContext) -> None],
    global_interceptors: list[InterceptorFns]
) -> HttpResponse:
    if len(global_guards) > 0:
        run_guards(global_guards, ctx)
    if len(route.guards) > 0:
        run_guards(route.guards, ctx)
    if len(global_pipes) > 0:
        run_pipes(global_pipes, ctx)
    if len(route.pipes) > 0:
        run_pipes(route.pipes, ctx)
    g_n: int = len(global_interceptors)
    r_n: int = len(route.interceptors)
    if g_n == 0 and r_n == 0:
        return route.handler(ctx)
    combined: list[InterceptorFns] = []
    i: int = 0
    while i < g_n:
        combined.append(global_interceptors[i])
        i = i + 1
    i = 0
    while i < r_n:
        combined.append(route.interceptors[i])
        i = i + 1
    before: BeforeResult = run_before(combined, ctx)
    early: HttpResponse | None = before.response
    if early != None:
        return run_after(combined, ctx, early, before.entered_count)
    resp: HttpResponse = route.handler(ctx)
    return run_after(combined, ctx, resp, before.entered_count)
