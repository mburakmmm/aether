# aether.jwt - HS256 JWT with exp / nbf / iat policy.
#
# Signing and signature checks go through nox.jwt (Nox >= 1.126).
# Aether still injects exp and rejects expired, early, or future-iat tokens.
# nox.jwt.sign/verify do not apply that policy.

import nox.json
import nox.jwt
from nox.jwt import JwtError as NoxJwtError
import nox.time

class JwtError(Exception):
    def __init__(self: JwtError, message: str) -> None:
        self.message = message

def _now_unix() -> int:
    return nox.time.now_ms() // 1000

def _find_object_field(v: JsonValue, name: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

def _with_exp(payload_json: str, exp_unix: int) -> str:
    v: JsonValue = nox.json.parse(payload_json)
    if not nox.json.is_object(v):
        raise JwtError("payload must be a JSON object")
    out: str = "{\"exp\":" + str(exp_unix)
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        key: str = nox.json.object_key(v, i)
        if key != "exp":
            out = out + "," + nox.json.dump_string(key) + ":" + nox.json.dump(nox.json.object_value(v, i))
        i = i + 1
    return out + "}"

def encode(secret: str, payload_json: str, exp_unix: int) -> str:
    if len(secret) == 0:
        raise JwtError("secret must not be empty")
    if exp_unix <= _now_unix():
        raise JwtError("exp_unix must be in the future")
    payload: str = _with_exp(payload_json, exp_unix)
    try:
        return nox.jwt.sign(payload, secret)
    except NoxJwtError as e:
        raise JwtError(e.message)

def _check_time_claims(payload: JsonValue) -> None:
    now: int = _now_unix()
    exp_v: JsonValue | None = _find_object_field(payload, "exp")
    if exp_v == None:
        raise JwtError("exp claim missing")
    else:
        if not nox.json.is_number(exp_v):
            raise JwtError("exp must be a number")
        else:
            exp_i: int = int(nox.json.as_number(exp_v))
            if now >= exp_i:
                raise JwtError("token expired")
    nbf_v: JsonValue | None = _find_object_field(payload, "nbf")
    if nbf_v != None:
        if not nox.json.is_number(nbf_v):
            raise JwtError("nbf must be a number")
        else:
            nbf_i: int = int(nox.json.as_number(nbf_v))
            if now < nbf_i:
                raise JwtError("token not yet valid (nbf)")
    iat_v: JsonValue | None = _find_object_field(payload, "iat")
    if iat_v != None:
        if not nox.json.is_number(iat_v):
            raise JwtError("iat must be a number")
        else:
            iat_i: int = int(nox.json.as_number(iat_v))
            if iat_i > now + 60:
                raise JwtError("iat is in the future")

def decode(secret: str, token: str) -> str:
    if len(secret) == 0:
        raise JwtError("secret must not be empty")
    payload_json: str = ""
    try:
        payload_json = nox.jwt.verify(token, secret)
    except NoxJwtError as e:
        raise JwtError(e.message)
    payload: JsonValue = nox.json.parse(payload_json)
    if not nox.json.is_object(payload):
        raise JwtError("payload must be an object")
    _check_time_claims(payload)
    return payload_json
