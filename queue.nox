# aether.queue — SQLite background job queue + worker + reclaim + DLQ.

import nox.sqlite
import nox.json
import nox.time
from nox.sqlite import Connection, Statement, SqliteError
from nox.db import Row
from nox.json import JsonError

class QueueError(Exception):
    def __init__(self: QueueError, message: str) -> None:
        self.message = message

def status_queued() -> str:
    return "queued"

def status_running() -> str:
    return "running"

def status_completed() -> str:
    return "completed"

def status_failed() -> str:
    return "failed"

def max_attempts() -> int:
    return 5

def default_stale_ms() -> int:
    return 300000

def open_db(path: str) -> Connection:
    return nox.sqlite.open(path)

def ensure_schema(db: Connection) -> None:
    db.execute(
        "CREATE TABLE IF NOT EXISTS aether_jobs (" +
        "id INTEGER PRIMARY KEY AUTOINCREMENT, " +
        "job_name TEXT NOT NULL, " +
        "payload TEXT NOT NULL, " +
        "status TEXT NOT NULL, " +
        "run_at_ms INTEGER NOT NULL, " +
        "attempts INTEGER NOT NULL DEFAULT 0, " +
        "last_error TEXT NOT NULL DEFAULT '', " +
        "created_at_ms INTEGER NOT NULL, " +
        "updated_at_ms INTEGER NOT NULL" +
        ")"
    )
    db.execute(
        "CREATE INDEX IF NOT EXISTS idx_aether_jobs_status_run_at ON aether_jobs (status, run_at_ms)"
    )
    db.execute(
        "CREATE INDEX IF NOT EXISTS idx_aether_jobs_status_updated ON aether_jobs (status, updated_at_ms)"
    )

def enqueue(db: Connection, job_name: str, payload_json: str, run_at_ms: int) -> int:
    if len(job_name) == 0:
        raise QueueError("job_name empty")
    nox.json.decode(payload_json)
    now: int = nox.time.now_ms()
    stmt: Statement = db.prepare(
        "INSERT INTO aether_jobs (job_name, payload, status, run_at_ms, attempts, last_error, created_at_ms, updated_at_ms) " +
        "VALUES (?, ?, 'queued', ?, 0, '', ?, ?)"
    )
    stmt.bind_str(0, job_name)
    stmt.bind_str(1, payload_json)
    stmt.bind_int(2, run_at_ms)
    stmt.bind_int(3, now)
    stmt.bind_int(4, now)
    stmt.execute()
    return db.last_insert_rowid()

def _job_json(id: int, job_name: str, payload_json: str, status: str, attempts: int, run_at_ms: int) -> str:
    return (
        "{\"id\":" + str(id) +
        ",\"job_name\":" + nox.json.encode_string(job_name) +
        ",\"payload\":" + payload_json +
        ",\"status\":" + nox.json.encode_string(status) +
        ",\"attempts\":" + str(attempts) +
        ",\"run_at_ms\":" + str(run_at_ms) + "}"
    )

def _job_row_json(row: Row) -> str:
    return (
        "{\"id\":" + str(row.get_int(0)) +
        ",\"job_name\":" + nox.json.encode_string(row.get_str(1)) +
        ",\"payload\":" + row.get_str(2) +
        ",\"status\":" + nox.json.encode_string(row.get_str(3)) +
        ",\"attempts\":" + str(row.get_int(4)) +
        ",\"run_at_ms\":" + str(row.get_int(5)) +
        ",\"last_error\":" + nox.json.encode_string(row.get_str(6)) +
        ",\"updated_at_ms\":" + str(row.get_int(7)) + "}"
    )

def reserve(db: Connection) -> str | None:
    db.execute("BEGIN IMMEDIATE")
    try:
        now: int = nox.time.now_ms()
        stmt: Statement = db.prepare(
            "SELECT id, job_name, payload, attempts, run_at_ms FROM aether_jobs " +
            "WHERE status = ? AND run_at_ms <= ? ORDER BY run_at_ms ASC, id ASC LIMIT 1"
        )
        stmt.bind_str(0, status_queued())
        stmt.bind_int(1, now)
        rows: list[Row] = stmt.query()
        if len(rows) == 0:
            db.execute("COMMIT")
            return None
        row: Row = rows[0]
        id: int = row.get_int(0)
        job_name: str = row.get_str(1)
        payload: str = row.get_str(2)
        attempts: int = row.get_int(3)
        run_at: int = row.get_int(4)
        upd: Statement = db.prepare(
            "UPDATE aether_jobs SET status = ?, updated_at_ms = ? WHERE id = ?"
        )
        upd.bind_str(0, status_running())
        upd.bind_int(1, now)
        upd.bind_int(2, id)
        upd.execute()
        db.execute("COMMIT")
        return _job_json(id, job_name, payload, status_running(), attempts, run_at)
    except SqliteError as e:
        db.execute("ROLLBACK")
        raise QueueError(e.message)

def reclaim_stale(db: Connection, stale_ms: int) -> int:
    # Stuck `running` jobs (worker crash) go back to queued.
    if stale_ms <= 0:
        stale_ms = default_stale_ms()
    now: int = nox.time.now_ms()
    cutoff: int = now - stale_ms
    cnt: Statement = db.prepare(
        "SELECT COUNT(*) FROM aether_jobs WHERE status = ? AND updated_at_ms < ?"
    )
    cnt.bind_str(0, status_running())
    cnt.bind_int(1, cutoff)
    cnt_rows: list[Row] = cnt.query()
    n: int = 0
    if len(cnt_rows) > 0:
        n = cnt_rows[0].get_int(0)
    if n == 0:
        return 0
    stmt: Statement = db.prepare(
        "UPDATE aether_jobs SET status = ?, last_error = ?, updated_at_ms = ?, run_at_ms = ? " +
        "WHERE status = ? AND updated_at_ms < ?"
    )
    stmt.bind_str(0, status_queued())
    stmt.bind_str(1, "reclaimed: stale running job")
    stmt.bind_int(2, now)
    stmt.bind_int(3, now)
    stmt.bind_str(4, status_running())
    stmt.bind_int(5, cutoff)
    stmt.execute()
    return n

def list_dead(db: Connection, limit: int) -> list[str]:
    # Dead-letter: permanently failed jobs.
    if limit <= 0:
        limit = 50
    stmt: Statement = db.prepare(
        "SELECT id, job_name, payload, status, attempts, run_at_ms, last_error, updated_at_ms " +
        "FROM aether_jobs WHERE status = ? ORDER BY updated_at_ms DESC, id DESC LIMIT ?"
    )
    stmt.bind_str(0, status_failed())
    stmt.bind_int(1, limit)
    rows: list[Row] = stmt.query()
    out: list[str] = []
    i: int = 0
    while i < len(rows):
        out.append(_job_row_json(rows[i]))
        i = i + 1
    return out

def requeue_dead(db: Connection, id: int) -> None:
    now: int = nox.time.now_ms()
    check: Statement = db.prepare(
        "SELECT id FROM aether_jobs WHERE id = ? AND status = ?"
    )
    check.bind_int(0, id)
    check.bind_str(1, status_failed())
    found: list[Row] = check.query()
    if len(found) == 0:
        raise QueueError("dead job not found: " + str(id))
    stmt: Statement = db.prepare(
        "UPDATE aether_jobs SET status = ?, attempts = 0, last_error = '', run_at_ms = ?, updated_at_ms = ? " +
        "WHERE id = ? AND status = ?"
    )
    stmt.bind_str(0, status_queued())
    stmt.bind_int(1, now)
    stmt.bind_int(2, now)
    stmt.bind_int(3, id)
    stmt.bind_str(4, status_failed())
    stmt.execute()

def mark_dead(db: Connection, id: int, error: str) -> None:
    # Move a job straight to the dead-letter (failed) state.
    now: int = nox.time.now_ms()
    sel: Statement = db.prepare("SELECT attempts FROM aether_jobs WHERE id = ?")
    sel.bind_int(0, id)
    rows: list[Row] = sel.query()
    if len(rows) == 0:
        raise QueueError("job not found: " + str(id))
    attempts: int = rows[0].get_int(0)
    if attempts < max_attempts():
        attempts = max_attempts()
    stmt: Statement = db.prepare(
        "UPDATE aether_jobs SET status = ?, attempts = ?, last_error = ?, updated_at_ms = ? WHERE id = ?"
    )
    stmt.bind_str(0, status_failed())
    stmt.bind_int(1, attempts)
    stmt.bind_str(2, error)
    stmt.bind_int(3, now)
    stmt.bind_int(4, id)
    stmt.execute()

def set_run_at(db: Connection, id: int, run_at_ms: int) -> None:
    now: int = nox.time.now_ms()
    stmt: Statement = db.prepare(
        "UPDATE aether_jobs SET run_at_ms = ?, updated_at_ms = ? WHERE id = ?"
    )
    stmt.bind_int(0, run_at_ms)
    stmt.bind_int(1, now)
    stmt.bind_int(2, id)
    stmt.execute()

    now: int = nox.time.now_ms()
    stmt: Statement = db.prepare(
        "UPDATE aether_jobs SET status = ?, updated_at_ms = ? WHERE id = ?"
    )
    stmt.bind_str(0, status_completed())
    stmt.bind_int(1, now)
    stmt.bind_int(2, id)
    stmt.execute()

def fail(db: Connection, id: int, error: str) -> None:
    now: int = nox.time.now_ms()
    sel: Statement = db.prepare("SELECT attempts FROM aether_jobs WHERE id = ?")
    sel.bind_int(0, id)
    rows: list[Row] = sel.query()
    if len(rows) == 0:
        raise QueueError("job not found: " + str(id))
    attempts: int = rows[0].get_int(0) + 1
    if attempts < max_attempts():
        backoff_ms: int = attempts * attempts * 1000
        stmt: Statement = db.prepare(
            "UPDATE aether_jobs SET status = ?, attempts = ?, last_error = ?, run_at_ms = ?, updated_at_ms = ? WHERE id = ?"
        )
        stmt.bind_str(0, status_queued())
        stmt.bind_int(1, attempts)
        stmt.bind_str(2, error)
        stmt.bind_int(3, now + backoff_ms)
        stmt.bind_int(4, now)
        stmt.bind_int(5, id)
        stmt.execute()
    else:
        stmt2: Statement = db.prepare(
            "UPDATE aether_jobs SET status = ?, attempts = ?, last_error = ?, updated_at_ms = ? WHERE id = ?"
        )
        stmt2.bind_str(0, status_failed())
        stmt2.bind_int(1, attempts)
        stmt2.bind_str(2, error)
        stmt2.bind_int(3, now)
        stmt2.bind_int(4, id)
        stmt2.execute()

class JobRegistry:
    _names: list[str]
    _handlers: list[(str) -> None]

    def __init__(self: JobRegistry) -> None:
        self._names = []
        self._handlers = []

    def register(self: JobRegistry, name: str, handler: (str) -> None) -> None:
        names: list[str] = self._names
        handlers: list[(str) -> None] = self._handlers
        names.append(name)
        handlers.append(handler)
        self._names = names
        self._handlers = handlers

    def get(self: JobRegistry, name: str) -> (str) -> None:
        i: int = 0
        while i < len(self._names):
            if self._names[i] == name:
                return self._handlers[i]
            i = i + 1
        raise QueueError("job handler not found: " + name)

def _field_str(v: JsonValue, name: str) -> str:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            val: JsonValue = nox.json.object_value(v, i)
            if nox.json.is_string(val):
                return nox.json.as_string(val)
            return nox.json.encode(val)
        i = i + 1
    raise QueueError("missing field: " + name)

def _field_int(v: JsonValue, name: str) -> int:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            val: JsonValue = nox.json.object_value(v, i)
            if nox.json.is_number(val):
                return int(nox.json.as_number(val))
        i = i + 1
    raise QueueError("missing int field: " + name)

def work(db: Connection, registry: JobRegistry, limit: int) -> int:
    processed: int = 0
    while processed < limit:
        raw_opt: str | None = reserve(db)
        if raw_opt != None:
            raw_s: str = raw_opt
            job: JsonValue = nox.json.decode(raw_s)
            id: int = _field_int(job, "id")
            name: str = _field_str(job, "job_name")
            payload: str = _field_str(job, "payload")
            try:
                handler: (str) -> None = registry.get(name)
                handler(payload)
                complete(db, id)
                processed = processed + 1
            except QueueError as e:
                fail(db, id, e.message)
                processed = processed + 1
            except Exception as e:
                fail(db, id, e.message)
                processed = processed + 1
        else:
            return processed
    return processed

def work_with_reclaim(db: Connection, registry: JobRegistry, limit: int, stale_ms: int) -> int:
    reclaim_stale(db, stale_ms)
    return work(db, registry, limit)

def work_forever(db: Connection, registry: JobRegistry, idle_sleep_ms: int) -> None:
    while True:
        n: int = work_with_reclaim(db, registry, 10, default_stale_ms())
        if n == 0:
            nox.time.sleep_ms(idle_sleep_ms)

def work_forever_stale(db: Connection, registry: JobRegistry, idle_sleep_ms: int, stale_ms: int) -> None:
    while True:
        n: int = work_with_reclaim(db, registry, 10, stale_ms)
        if n == 0:
            nox.time.sleep_ms(idle_sleep_ms)
