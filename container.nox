# aether.container - provider name registry only (no request bag).
# Request-scoped values live in TaskLocal RequestState (aether.context).

class ContainerError(Exception):
    def __init__(self: ContainerError, message: str) -> None:
        self.message = message

class Container:
    _names: list[str]

    def __init__(self: Container) -> None:
        self._names = []

    def register_name(self: Container, name: str) -> None:
        if len(name) == 0:
            raise ContainerError("provider name empty")
        if self.has(name):
            raise ContainerError("duplicate provider name: " + name)
        names: list[str] = self._names
        names.append(name)
        self._names = names

    def has(self: Container, name: str) -> bool:
        i: int = 0
        while i < len(self._names):
            if self._names[i] == name:
                return True
            i = i + 1
        return False

    def names(self: Container) -> list[str]:
        return self._names
