# aether.container — string-token provider registry.
# Typed access: prefer closure injection in ModuleBuilder handlers.
# container.get returns Injectable (subclass your services).

class ContainerError(Exception):
    def __init__(self: ContainerError, message: str) -> None:
        self.message = message

class Injectable:
    def __init__(self: Injectable) -> None:
        self._aether_injectable = True

class Container:
    def __init__(self: Container) -> None:
        self._services: dict[str, Injectable] = {}
        self._request: dict[str, str] = {}

    def provide(self: Container, name: str, service: Injectable) -> None:
        if len(name) == 0:
            raise ContainerError("provider name empty")
        self._services[name] = service

    def has(self: Container, name: str) -> bool:
        keys: list[str] = self._services.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == name:
                return True
            i = i + 1
        return False

    def get(self: Container, name: str) -> Injectable:
        if not self.has(name):
            raise ContainerError("provider not found: " + name)
        return self._services[name]

    def set_request_value(self: Container, key: str, value: str) -> None:
        self._request[key] = value

    def get_request_value(self: Container, key: str) -> str:
        keys: list[str] = self._request.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == key:
                return self._request[key]
            i = i + 1
        return ""

    def clear_request(self: Container) -> None:
        self._request = {}
