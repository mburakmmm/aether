# aether.container — provider name registry + request-scoped string bag.
# Cross-module class inheritance is not supported in Nox, so typed service
# instances are held via closures in ModuleBuilder handlers (not here).

class ContainerError(Exception):
    def __init__(self: ContainerError, message: str) -> None:
        self.message = message

class Container:
    def __init__(self: Container) -> None:
        names: list[str] = []
        request: dict[str, str] = {}
        self._names = names
        self._request = request

    def register_name(self: Container, name: str) -> None:
        if len(name) == 0:
            raise ContainerError("provider name empty")
        names: list[str] = self._names
        names.append(name)
        self._names = names

    def has(self: Container, name: str) -> bool:
        i: int = 0
        while i < len(self._names):
            if self._names[i] == name:
                return True
            i = i + 1
        return False

    def names(self: Container) -> list[str]:
        return self._names

    def set_request_value(self: Container, key: str, value: str) -> None:
        self._request[key] = value

    def get_request_value(self: Container, key: str) -> str:
        keys: list[str] = self._request.keys()
        i: int = 0
        while i < len(keys):
            if keys[i] == key:
                return self._request[key]
            i = i + 1
        return ""

    def clear_request(self: Container) -> None:
        empty: dict[str, str] = {}
        self._request = empty
